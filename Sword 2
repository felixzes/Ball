-- ─── Orientation ─────────────────────────────────────────────────────────────
local swordYaw   = 0
local swordPitch = 0

local function rotatePoint(x, y, z)
    local cosY = math.cos(swordYaw);   local sinY = math.sin(swordYaw)
    local cosP = math.cos(swordPitch); local sinP = math.sin(swordPitch)
    local rx  = cosY*x - sinY*z
    local rz  = sinY*x + cosY*z
    local ry2 = cosP*y - sinP*rz
    local rz2 = sinP*y + cosP*rz
    return rx, ry2, rz2
end

--[[
═══════════════════════════════════════════════════════
  DEVIL'S BLADE — silhouette reference breakdown
  Total Y span: 120 studs. Y=0 bottom, Y=120 tip.
  Centered: pommel base at -60, tip at +60.

  Y layout (bottom → top):
    0  – 12   Pommel (large circular eye socket)
    12 – 22   Grip (short wrapped handle)
    22 – 26   Crossguard center block
    26 – 26   Horn roots + swept horns extend ±X
    26 – 42   Horn sweep zone (arcs outward and curves back)
    42 – 50   Ricasso / blade root (widest point)
    50 – 105  Blade body (broad, tapers slowly)
    105– 120  Blade tip (fast taper to point)

  Blade profile:
    At Y=42:  halfWidth=14, halfDepth=2.5  ← widest
    At Y=105: halfWidth=5,  halfDepth=1.2
    At Y=120: halfWidth=0,  halfDepth=0    ← point

  Horns:
    Two swept curved horns rooted at Y≈26–28
    Left horn arcs: X from −8 → −22, Y from 26 → 38, then curves back up
    Right horn mirrors
    Each horn also has a smaller inner fang below the main arc
═══════════════════════════════════════════════════════
]]

-- blade cross-section at absolute Y
local function bladeHW(y)
    if y < 42 then return 14, 2.5 end
    if y > 120 then return 0, 0 end
    if y <= 105 then
        local t = (y - 42) / (105 - 42)
        return 14 - t * 9, 2.5 - t * 1.3
    end
    local t = (y - 105) / 15
    return 5 * (1 - t), 1.2 * (1 - t)
end

-- ─── Section definitions ──────────────────────────────────────────────────────
--[[
  Each section: id, frac (relative particle count weight), solver function
  Solver receives (j, n) → returns x, y, z local offset
]]

local TOTAL = 120

local function goldenTheta(j) return (j * 2.399963) % (2*math.pi) end
local function rand01(j, salt) return ((j * 1618 + salt * 31337) % 1000) / 1000 end

local SECTIONS = {}

-- ── 1. Pommel — large flat circle (eye socket ring + filled disc)
table.insert(SECTIONS, { frac = 0.10, solve = function(j, n)
    local lt    = (j-1)/(n-1+1e-9)
    -- outer ring is denser, inner filled
    local ring  = (lt < 0.55)  -- 55% on ring, 45% fill
    local theta = goldenTheta(j)
    local r
    if ring then
        r = 9 + rand01(j,1) * 2.5
    else
        r = rand01(j,2) ^ 0.5 * 8.5
    end
    local y = 4 + rand01(j,3) * 7   -- spread across Y 0–11
    return r * math.cos(theta), y - TOTAL/2, r * math.sin(theta) * 0.35
end})

-- ── 2. Eye pupil — small ellipse in center of pommel
table.insert(SECTIONS, { frac = 0.025, solve = function(j, n)
    local theta = goldenTheta(j)
    local r     = rand01(j,4) ^ 0.5 * 3.5
    local y     = 5 + rand01(j,5) * 4
    return r * math.cos(theta) * 1.2, y - TOTAL/2, r * math.sin(theta) * 0.5
end})

-- ── 3. Grip — narrow wrapped column
table.insert(SECTIONS, { frac = 0.06, solve = function(j, n)
    local lt    = (j-1)/(n-1+1e-9)
    local y     = 12 + lt * 10
    local theta = goldenTheta(j)
    local r     = 2.2 + math.sin(lt * math.pi * 6) * 0.6   -- wrap ridges
    r = r * (rand01(j,6) * 0.4 + 0.8)
    return r * math.cos(theta), y - TOTAL/2, r * math.sin(theta) * 0.5
end})

-- ── 4. Crossguard center block — flat horizontal bar at Y≈22-28
table.insert(SECTIONS, { frac = 0.03, solve = function(j, n)
    local lt = (j-1)/(n-1+1e-9)
    local x  = (lt - 0.5) * 20          -- ±10 wide
    local y  = 22 + rand01(j,7) * 6
    local z  = (rand01(j,8) - 0.5) * 4
    return x, y - TOTAL/2, z
end})

-- ── 5. Left horn — large swept curved horn
--    Arc: root at (-8, 26), sweeps to (-24, 34), curves tip back to (-18, 42)
table.insert(SECTIONS, { frac = 0.07, solve = function(j, n)
    local lt    = (j-1)/(n-1+1e-9)
    -- parametric arc
    local angle = lt * math.pi * 0.9          -- 0 → ~162°
    local armR  = 10 + lt * 6                 -- grows as it sweeps
    local cx    = -12; local cy = 30          -- arc center
    local x     = cx + armR * math.cos(math.pi + angle * 0.7)
    local y     = cy + armR * math.sin(angle) * 0.9
    local z     = (rand01(j,9) - 0.5) * 2.5
    -- thickness tapers toward tip
    local thick = (1 - lt) * 3.5 + 0.6
    x = x + (rand01(j,10) - 0.5) * thick
    return x, y - TOTAL/2, z
end})

-- ── 6. Right horn — mirror of left
table.insert(SECTIONS, { frac = 0.07, solve = function(j, n)
    local lt    = (j-1)/(n-1+1e-9)
    local angle = lt * math.pi * 0.9
    local armR  = 10 + lt * 6
    local cx    = 12; local cy = 30
    local x     = cx - armR * math.cos(math.pi + angle * 0.7)
    local y     = cy + armR * math.sin(angle) * 0.9
    local z     = (rand01(j,11) - 0.5) * 2.5
    local thick = (1 - lt) * 3.5 + 0.6
    x = x + (rand01(j,12) - 0.5) * thick
    return x, y - TOTAL/2, z
end})

-- ── 7. Left inner fang — smaller downward spur below main horn
table.insert(SECTIONS, { frac = 0.03, solve = function(j, n)
    local lt = (j-1)/(n-1+1e-9)
    local x  = -6 - lt * 8
    local y  = 24 - lt * 6          -- goes downward
    local z  = (rand01(j,13) - 0.5) * 2
    local t2 = (1-lt)*2.5+0.4
    x = x + (rand01(j,14)-0.5)*t2
    return x, y - TOTAL/2, z
end})

-- ── 8. Right inner fang
table.insert(SECTIONS, { frac = 0.03, solve = function(j, n)
    local lt = (j-1)/(n-1+1e-9)
    local x  =  6 + lt * 8
    local y  = 24 - lt * 6
    local z  = (rand01(j,15) - 0.5) * 2
    local t2 = (1-lt)*2.5+0.4
    x = x + (rand01(j,16)-0.5)*t2
    return x, y - TOTAL/2, z
end})

-- ── 9. Blade root / ricasso — widest section, flat broad plate
table.insert(SECTIONS, { frac = 0.06, solve = function(j, n)
    local lt    = (j-1)/(n-1+1e-9)
    local y     = 42 + lt * 8
    local hw, hd = bladeHW(y)
    local theta = goldenTheta(j)
    local r     = rand01(j,17)^0.5
    return r*hw*math.cos(theta), y - TOTAL/2, r*hd*math.sin(theta)
end})

-- ── 10. Blade body — broad tapered body with fuller groove
table.insert(SECTIONS, { frac = 0.28, solve = function(j, n)
    local lt    = (j-1)/(n-1+1e-9)
    local y     = 50 + lt * 55
    local hw, hd = bladeHW(y)
    local theta = goldenTheta(j)
    local r     = rand01(j,18)^0.5
    -- fuller: cluster some toward spine center
    local inFuller = rand01(j,19) < 0.15
    if inFuller then
        return (rand01(j,20)-0.5)*hw*0.3, y - TOTAL/2, (rand01(j,21)-0.5)*0.3
    end
    return r*hw*math.cos(theta), y - TOTAL/2, r*hd*math.sin(theta)
end})

-- ── 11. Cutting edge emphasis — particles clustered toward ±X faces
table.insert(SECTIONS, { frac = 0.08, solve = function(j, n)
    local lt    = (j-1)/(n-1+1e-9)
    local y     = 50 + lt * 55
    local hw, hd = bladeHW(y)
    local side  = (j % 2 == 0) and 1 or -1
    local edge  = hw * 0.92 + (rand01(j,22)-0.5)*1.5
    local z     = (rand01(j,23)-0.5)*hd*0.8
    return side * edge, y - TOTAL/2, z
end})

-- ── 12. Spine / back edge — narrow line along Z center
table.insert(SECTIONS, { frac = 0.03, solve = function(j, n)
    local lt = (j-1)/(n-1+1e-9)
    local y  = 50 + lt * 55
    local hw, hd = bladeHW(y)
    return (rand01(j,24)-0.5)*hw*0.12, y - TOTAL/2, (rand01(j,25)-0.5)*hd*0.25
end})

-- ── 13. Blade tip — fast taper to point
table.insert(SECTIONS, { frac = 0.07, solve = function(j, n)
    local lt    = (j-1)/(n-1+1e-9)
    local y     = 105 + lt * 15
    local hw, hd = bladeHW(y)
    local theta = goldenTheta(j)
    local r     = rand01(j,26)^0.4
    return r*hw*math.cos(theta), y - TOTAL/2, r*hd*math.sin(theta)
end})

-- ── 14. Aura glow ring — loose halo around crossguard / pommel area
table.insert(SECTIONS, { frac = 0.04, solve = function(j, n)
    local theta = goldenTheta(j)
    local r     = 13 + rand01(j,27) * 8
    local y     = 18 + rand01(j,28) * 18
    return r*math.cos(theta), y - TOTAL/2, r*math.sin(theta)*0.5
end})

-- ─── Section map builder ──────────────────────────────────────────────────────
local function buildSectionMap(count)
    local map        = {}
    local totalFrac  = 0
    for _, s in ipairs(SECTIONS) do totalFrac = totalFrac + s.frac end

    local assigned = 0
    local alloc    = {}
    for si, s in ipairs(SECTIONS) do
        local n = (si == #SECTIONS)
            and (count - assigned)
            or  math.max(1, math.floor(s.frac / totalFrac * count))
        alloc[si] = n
        assigned  = assigned + n
    end

    local idx = 1
    for si, s in ipairs(SECTIONS) do
        local n = alloc[si]
        for j = 1, n do
            if idx > count then break end
            local x, y, z = s.solve(j, n)
            map[idx] = { x=x, y=y, z=z }
            idx = idx + 1
        end
    end
    while idx <= count do
        map[idx] = { x=0, y=TOTAL/2 - TOTAL/2, z=0 }
        idx = idx + 1
    end
    return map
end

-- ─── Part pool ────────────────────────────────────────────────────────────────
local parts      = {}
local sectionMap = {}
local lastCount  = 0

local function isEligible(part)
    if not part:IsA("BasePart") then return false end
    if part.Anchored then return false end
    if not part:IsDescendantOf(Workspace) then return false end
    if part:IsDescendantOf(Folder) then return false end
    if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then return false end
    local a = part.Parent
    while a and a ~= Workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
        a = a.Parent
    end
    return true
end

local function forcePart(part)
    for _, x in next, part:GetChildren() do
        if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
        or x:IsA("BodyPosition") or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
        or x:IsA("RocketPropulsion") then x:Destroy() end
    end
    if part:FindFirstChild("SwordAttach") then part:FindFirstChild("SwordAttach"):Destroy() end
    if part:FindFirstChild("SwordAlign")  then part:FindFirstChild("SwordAlign"):Destroy()  end
    if part:FindFirstChild("SwordTorque") then part:FindFirstChild("SwordTorque"):Destroy() end
    part.CanCollide = false
    local att  = Instance.new("Attachment", part); att.Name  = "SwordAttach"
    local torq = Instance.new("Torque",     part); torq.Name = "SwordTorque"
    torq.Torque      = Vector3.new(1e5, 1e5, 1e5)
    torq.Attachment0 = att
    local nodeAtt         = Instance.new("Attachment", MasterAnchor)
    local ap              = Instance.new("AlignPosition", part); ap.Name = "SwordAlign"
    ap.MaxForce           = math.huge
    ap.MaxVelocity        = math.huge
    ap.Responsiveness     = 1000
    ap.Attachment0        = att
    ap.Attachment1        = nodeAtt
    ap.Parent             = part
end

local function addPart(part)
    if not isEligible(part) then return end
    if table.find(parts, part) then return end
    if getgenv().Network then getgenv().Network.RetainPart(part) end
    forcePart(part)
    table.insert(parts, part)
end

local function removePart(part)
    local i = table.find(parts, part)
    if i then table.remove(parts, i) end
end

for _, d in ipairs(Workspace:GetDescendants()) do addPart(d) end
Workspace.DescendantAdded:Connect(addPart)
Workspace.DescendantRemoving:Connect(removePart)
RunService.Stepped:Connect(function()
    for _, p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored then addPart(p) end
    end
end)

-- ─── Shape engine ─────────────────────────────────────────────────────────────
local sphereEnabled = false

RunService.Heartbeat:Connect(function()
    if not sphereEnabled then return end
    local count = #parts
    if count ~= lastCount then
        sectionMap = buildSectionMap(count)
        lastCount  = count
    end
    for i, part in ipairs(parts) do
        if part.Parent and not part.Anchored then
            local slot = sectionMap[i]
            if slot then
                local rx, ry, rz = rotatePoint(slot.x, slot.y, slot.z)
                local target     = centerPos + Vector3.new(rx, ry, rz)
                local dir        = target - part.Position
                if dir.Magnitude > 0 then
                    part.Velocity = dir.Unit * 999999
                end
            end
        end
    end
end)

