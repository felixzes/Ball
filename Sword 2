local swordJoyActive  = false
local swordJoyTouchId = nil
local swordJoyOrigin  = Vector2.new()
local swordJoyDelta   = Vector2.new()
local SWORD_JOY_RADIUS   = 45
local SWORD_ROTATE_SPEED = 0.022

local function clampKnob(delta, maxR)
    local mag = delta.Magnitude
    return mag > maxR and (delta / mag * maxR) or delta
end

SwordPad.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.Touch
    or  input.UserInputType == Enum.UserInputType.MouseButton1)
    and not swordJoyActive then
        swordJoyActive  = true
        swordJoyTouchId = input
        swordJoyOrigin  = Vector2.new(input.Position.X, input.Position.Y)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if swordJoyActive and input == swordJoyTouchId then
        local delta   = Vector2.new(input.Position.X, input.Position.Y) - swordJoyOrigin
        local clamped = clampKnob(delta, SWORD_JOY_RADIUS)
        swordJoyDelta = clamped
        SwordKnob.Position = UDim2.new(0.5, clamped.X - 19, 0.5, clamped.Y - 19)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input == swordJoyTouchId then
        swordJoyActive  = false
        swordJoyTouchId = nil
        swordJoyDelta   = Vector2.new()
        SwordKnob.Position = UDim2.new(0.5, -19, 0.5, -19)
    end
end)
RunService.Heartbeat:Connect(function()
    if not swordJoyActive then return end
    swordYaw   = swordYaw + swordJoyDelta.X * SWORD_ROTATE_SPEED
    swordPitch = math.clamp(
        swordPitch + swordJoyDelta.Y * SWORD_ROTATE_SPEED,
        -math.pi * 0.88, math.pi * 0.88
    )
    yawDeg   = math.floor(math.deg(swordYaw) % 360 + 0.5)
    pitchDeg = math.floor(math.deg(swordPitch) + 0.5)
end)

