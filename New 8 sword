                  C(140,20,0), C(255,220,220), 13)
    d.MouseButton1Click:Connect(function() onDec(); disp.Text = tostring(getV()) end)
    u.MouseButton1Click:Connect(function() onInc(); disp.Text = tostring(getV()) end)
    return disp
end

