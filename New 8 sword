--  SWORD SYSTEM
-- ════════════════════════════════════════════════════════════════════════════
local SWORD_COUNT     = 8
local BASE_LEFT_STUDS = 45
local SWORD_SPACING   = 4

local partOwner       = {}
local partCounter     = 0
local activeSwordCount = 0
local swords          = {}

-- Unique tag per sword to avoid cross-sword constraint collisions
local function tagName(si, kind) return ("DB_%d_%s"):format(si, kind) end

local function getFollowPos(si)
    if not humanoidRootPart then return Vector3.new(0, 0, 0) end
    -- camera-relative left so the formation faces wherever you're looking
    local cam  = Workspace.CurrentCamera
    local look = cam and cam.CFrame.LookVector or humanoidRootPart.CFrame.LookVector
    look       = Vector3.new(look.X, 0, look.Z).Unit
    local left = Vector3.new(-look.Z, 0, look.X)  -- 90° left on XZ plane
    local dist = BASE_LEFT_STUDS + (si - 1) * SWORD_SPACING
    return humanoidRootPart.Position + left * dist
end

local function isEligible(p)
    if not p:IsA("BasePart") then return false end
    if p.Anchored then return false end
    if not p:IsDescendantOf(Workspace) then return false end
    for _, sw in ipairs(swords) do
        if sw.folder and p:IsDescendantOf(sw.folder) then return false end
    end
    if LocalPlayer.Character and p:IsDescendantOf(LocalPlayer.Character) then return false end
    local a = p.Parent
    while a and a ~= Workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
        a = a.Parent
    end
    return true
end

local function cleanPart(p, si)
    if not p or not p.Parent then return end
    -- remove all named constraints/attachments for this sword slot
    for _, name in ipairs({tagName(si,"Att"), tagName(si,"AP"), tagName(si,"AO"), tagName(si,"AncAtt")}) do
        local c = p:FindFirstChild(name)
        if c then c:Destroy() end
    end
    -- also clean anchor-side attachment that's keyed to this part
    -- (stored as a child of the anchor; we tag them with part's guid-equivalent)
end

local function forcePart(p, sw)
    local si = sw.slotIndex
    -- strip any legacy force objects
    for _, x in next, p:GetChildren() do
        if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
        or x:IsA("BodyPosition")        or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
        or x:IsA("RocketPropulsion") then x:Destroy() end
    end
    cleanPart(p, si)
    p.CanCollide = false

    -- Attachment on the part
    local att  = Instance.new("Attachment", p)
    att.Name   = tagName(si, "Att")

    -- Attachment on the anchor (one per retained part)
    local ancAtt  = Instance.new("Attachment", sw.anchor)
    ancAtt.Name   = tagName(si, "AncAtt") .. "_" .. tostring(p:GetDebugId())

    -- AlignPosition: moves part to anchor attachment world position each frame
    local ap       = Instance.new("AlignPosition", p)
    ap.Name        = tagName(si, "AP")
    ap.MaxForce    = math.huge
    ap.MaxVelocity = math.huge
    ap.Responsiveness = 200  -- was unlimited before — now smooth but fast
    ap.Attachment0 = att
    ap.Attachment1 = ancAtt

    -- AlignOrientation: keeps part's orientation fixed (replaces broken Torque hack)
    local ao           = Instance.new("AlignOrientation", p)
    ao.Name            = tagName(si, "AO")
    ao.MaxAngularVelocity = math.huge
    ao.MaxTorque          = math.huge
    ao.Responsiveness     = 200
    ao.Attachment0 = att
    ao.Attachment1 = ancAtt

    sw._anchorAtts[p] = ancAtt  -- track for cleanup
end

local function createSword(slotIndex)
    local sw           = {}
    sw.slotIndex       = slotIndex
    sw.enabled         = false
    sw.fingerActive    = false
    sw.fingerTouch     = nil
    sw.yaw             = 0
    sw.pitch           = 0
    sw.parts           = {}
    sw.centerPos       = humanoidRootPart and humanoidRootPart.Position or Vector3.new()
    sw._anchorAtts     = {}   -- p -> Attachment on anchor, for cleanup

    sw.folder  = Instance.new("Folder", Workspace)
    sw.folder.Name = "DevilsBlade_SW"..slotIndex
    sw.anchor  = Instance.new("Part", sw.folder)
    sw.anchor.Anchored      = true
    sw.anchor.CanCollide    = false
    sw.anchor.Transparency  = 1
    sw.anchor.Size          = Vector3.new(1,1,1)
    sw.anchor.Position      = sw.centerPos

    sw.rot = function(x, y, z)
        local cy, sy = math.cos(sw.yaw),  math.sin(sw.yaw)
        local cp, sp = math.cos(sw.pitch), math.sin(sw.pitch)
        local rx = cy*x - sy*z
        local rz = sy*x + cy*z
        return rx, cp*y - sp*rz, sp*y + cp*rz
    end

    sw.removePart = function(p)
        local idx = table.find(sw.parts, p)
        if idx then table.remove(sw.parts, idx) end
        if partOwner[p] == slotIndex then partOwner[p] = nil end
        cleanPart(p, slotIndex)
        -- destroy anchor attachment too
        if sw._anchorAtts[p] then
            sw._anchorAtts[p]:Destroy()
            sw._anchorAtts[p] = nil
        end
    end

    sw.addPart = function(p)
        if not sw.enabled then return end
        if not isEligible(p) then return end
        if table.find(sw.parts, p) then return end
        local owner = partOwner[p]
        if owner == nil then
            if activeSwordCount == 0 then return end
            partCounter = partCounter + 1
            local assigned = ((partCounter-1) % activeSwordCount) + 1
            partOwner[p] = assigned; owner = assigned
        end
        if owner ~= slotIndex then return end
        if getgenv().Network then getgenv().Network.RetainPart(p) end
        forcePart(p, sw)
        table.insert(sw.parts, p)
    end

    return sw
end

for i = 1, SWORD_COUNT do
    table.insert(swords, createSword(i))
end

-- ─── Partition reset ─────────────────────────────────────────────────────────
local function resetPartitions()
    for _, sw in ipairs(swords) do
        for _, p in ipairs(sw.parts) do
            cleanPart(p, sw.slotIndex)
            if sw._anchorAtts[p] then sw._anchorAtts[p]:Destroy(); sw._anchorAtts[p] = nil end
        end
        sw.parts = {}
        -- destroy all anchor attachments
        for _, ch in ipairs(sw.anchor:GetChildren()) do
            if ch:IsA("Attachment") then ch:Destroy() end
        end
        sw._anchorAtts = {}
    end
    partOwner = {}; partCounter = 0
    if activeSwordCount == 0 then return end

    local pool = {}
    for _, p in ipairs(Workspace:GetDescendants()) do
        if isEligible(p) then
            table.insert(pool, p)
        end
    end

    for i, p in ipairs(pool) do
        local assigned = ((i-1) % activeSwordCount) + 1
        partOwner[p]  = assigned
        partCounter    = i
        local sw       = swords[assigned]
        if sw.enabled then
            if getgenv().Network then getgenv().Network.RetainPart(p) end
            forcePart(p, sw)
            table.insert(sw.parts, p)
        end
    end
end

-- ─── Global part wiring ──────────────────────────────────────────────────────
local function globalAdd(p)
    if activeSwordCount == 0 then return end
    if partOwner[p] then
        -- already assigned — just ensure it's wired if its sword is active
        local sw = swords[partOwner[p]]
        if sw and sw.enabled and not table.find(sw.parts, p) and isEligible(p) then
            forcePart(p, sw); table.insert(sw.parts, p)
        end
        return
    end
    if not isEligible(p) then return end
    partCounter = partCounter + 1
    local assigned = ((partCounter-1) % activeSwordCount) + 1
    partOwner[p]   = assigned
    local sw       = swords[assigned]
    if sw and sw.enabled then
        if getgenv().Network then getgenv().Network.RetainPart(p) end
        forcePart(p, sw); table.insert(sw.parts, p)
    end
end

local function globalRemove(p)
    local si = partOwner[p]
    if si then
        local sw = swords[si]
        if sw then sw.removePart(p) end
    end
    partOwner[p] = nil
end

Workspace.DescendantAdded:Connect(function(p)
    task.defer(function() globalAdd(p) end)  -- defer so parent is set
end)
Workspace.DescendantRemoving:Connect(globalRemove)

-- Periodic sweep: catch anything missed (runs every 2s to spare CPU)
local _sweepClock = 0
RunService.Heartbeat:Connect(function(dt)
    _sweepClock = _sweepClock + dt
    if _sweepClock < 2 then return end
    _sweepClock = 0
    for _, p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored and not partOwner[p] then
            globalAdd(p)
        end
    end
end)

-- ─── Shape engine — distance-proportional velocity, smooth chase ─────────────
RunService.Heartbeat:Connect(function()
    for _, sw in ipairs(swords) do
        if not sw.enabled then continue end
        local ancPos = sw.anchor.Position
        local i      = 0
        for _, part in ipairs(sw.parts) do
            if part.Parent and not part.Anchored then
                i = i + 1
                local s        = getSlot(i)
                local rx, ry, rz = sw.rot(s.x, s.y, s.z)
                local target   = ancPos + Vector3.new(rx, ry, rz)
                -- move anchor attachment to target so AlignPosition drives the part
                local ancAtt = sw._anchorAtts[part]
                if ancAtt then
                    ancAtt.WorldPosition = target
                end
            end
        end
    end
end)

-- ─── Follow engine ───────────────────────────────────────────────────────────
RunService.Heartbeat:Connect(function()
    for _, sw in ipairs(swords) do
        if sw.enabled and not sw.fingerActive then
            sw.centerPos       = getFollowPos(sw.slotIndex)
            sw.anchor.Position = sw.centerPos
        end
    end
end)

-- ─── Y-locked screen-to-world resolver ──────────────────────────────────────
local function screenToWorld(sp, planeY)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local ray = cam:ScreenPointToRay(sp.X, sp.Y)
    local d   = ray.Direction
    if math.abs(d.Y) < 0.0001 then return ray.Origin + d * 200 end
    local t = (planeY - ray.Origin.Y) / d.Y
    if t <= 0 then return ray.Origin + d * 200 end
    return ray.Origin + d * t
end

