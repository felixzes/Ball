-- ─── Blackhole finger drag on overlay ────────────────────────────────────────
-- when in blackhole mode, any tap/drag on the overlay moves bhCenter

local function screenToWorldBH(sp)
    local cam=Workspace.CurrentCamera if not cam then return nil end
    local ray=cam:ScreenPointToRay(sp.X,sp.Y)
    local d=ray.Direction
    local planeY=bhCenter.Y
    if math.abs(d.Y)<0.0001 then return nil end
    local t=(planeY-ray.Origin.Y)/d.Y
    if t<=0 then return nil end
    return ray.Origin+d*t
end

overlay.InputBegan:Connect(function(inp)
    if currentMode~="Blackhole" then return end
    if inp.UserInputType~=Enum.UserInputType.Touch
    and inp.UserInputType~=Enum.UserInputType.MouseButton1 then return end
    if bhDragging then return end
    bhDragging=true bhDragTouch=inp
    local wp=screenToWorldBH(Vector2.new(inp.Position.X,inp.Position.Y))
    if wp then
        bhCenter=Vector3.new(wp.X,bhCenter.Y,wp.Z)
    end
end)

UserInputService.InputChanged:Connect(function(inp)
    if currentMode~="Blackhole" then return end
    if not bhDragging or inp~=bhDragTouch then return end
    if inp.UserInputType~=Enum.UserInputType.Touch
    and inp.UserInputType~=Enum.UserInputType.MouseMovement then return end
    local wp=screenToWorldBH(Vector2.new(inp.Position.X,inp.Position.Y))
    if wp then
        bhCenter=Vector3.new(wp.X,bhCenter.Y,wp.Z)
        -- immediately push anchors
        for i,sw in ipairs(swords) do
            if sw.enabled then
                sw.centerPos=getBlackholePos(i,modeTime)
                sw.anchor.Position=sw.centerPos
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(inp)
    if inp==bhDragTouch then
        bhDragging=false bhDragTouch=nil
    end
end)

-- ─── Per-sword finger drag (non-blackhole modes) ──────────────────────────────
local touchToSword={}
local swordDragY={}

local function screenToWorldSW(sp,planeY)
    local cam=Workspace.CurrentCamera if not cam then return nil end
    local ray=cam:ScreenPointToRay(sp.X,sp.Y)
    local d=ray.Direction
    if math.abs(d.Y)<0.0001 then return ray.Origin+d*200 end
    local t=(planeY-ray.Origin.Y)/d.Y
    if t<=0 then return ray.Origin+d*200 end
    return ray.Origin+d*t
end

overlay.InputBegan:Connect(function(inp)
    if currentMode=="Blackhole" then return end
    if inp.UserInputType~=Enum.UserInputType.Touch
    and inp.UserInputType~=Enum.UserInputType.MouseButton1 then return end
    for i,sw in ipairs(swords) do
        if sw.enabled and not sw.fingerActive then
            sw.fingerActive=true sw.fingerTouch=inp
            touchToSword[inp]=i swordDragY[i]=sw.centerPos.Y
            local wp=screenToWorldSW(Vector2.new(inp.Position.X,inp.Position.Y),swordDragY[i])
            if wp then
                sw.centerPos=Vector3.new(wp.X,swordDragY[i],wp.Z)
                sw.anchor.Position=sw.centerPos
            end
            break
        end
    end
end)

UserInputService.InputChanged:Connect(function(inp)
    if currentMode=="Blackhole" then return end
    local i=touchToSword[inp] if not i then return end
    local sw=swords[i] if not sw or not sw.fingerActive then return end
    if inp.UserInputType~=Enum.UserInputType.Touch
    and inp.UserInputType~=Enum.UserInputType.MouseMovement then return end
    local wp=screenToWorldSW(Vector2.new(inp.Position.X,inp.Position.Y),swordDragY[i] or sw.centerPos.Y)
    if wp then
        sw.centerPos=Vector3.new(wp.X,swordDragY[i],wp.Z)
        sw.anchor.Position=sw.centerPos
    end
end)

UserInputService.InputEnded:Connect(function(inp)
    if currentMode=="Blackhole" then return end
    local i=touchToSword[inp] if not i then return end
    local sw=swords[i]
    if sw then
        sw.fingerActive=false sw.fingerTouch=nil swordDragY[i]=nil
        sw.centerPos=getTargetPos(i,modeTime)
        sw.anchor.Position=sw.centerPos
    end
    touchToSword[inp]=nil
end)

