-- ── Blade profile function ────────────────────────────────────────────────────
-- returns halfWidth, halfDepth at local Y
-- widest at Y=-14 (ricasso shoulder), tapers to 0 at Y=60 (tip)
local BLADE_ROOT_Y  = -14
local BLADE_TIP_Y   =  60
local BLADE_MAX_HW  =  13.5   -- half-width at root
local BLADE_MAX_HD  =   2.2   -- half-depth at root

local function bladeProfile(y)
    if y <= BLADE_ROOT_Y then
        -- ricasso: constant full width
        return BLADE_MAX_HW, BLADE_MAX_HD
    end
    if y >= BLADE_TIP_Y then return 0, 0 end
    -- body taper: root → point at y=54
    local bodyEnd = 54
    if y <= bodyEnd then
        local t  = (y - BLADE_ROOT_Y) / (bodyEnd - BLADE_ROOT_Y)
        -- convex taper — stays wide longer then narrows fast
        local hw = BLADE_MAX_HW * (1 - t^1.6)
        local hd = BLADE_MAX_HD * (1 - t^1.3)
        return math.max(0,hw), math.max(0,hd)
    end
    -- tip zone: fast linear collapse
    local t  = (y - bodyEnd) / (BLADE_TIP_Y - bodyEnd)
    return BLADE_MAX_HW*(1-t)*0.08, BLADE_MAX_HD*(1-t)*0.18
end

