-- ─── 500-point sword target table ────────────────────────────────────────────
local TARGETS = {}
local PHI = (1+math.sqrt(5))/2

local function sunflower(i,n,scale,flatZ)
    local r=scale*math.sqrt(i/n)
    local theta=2*math.pi*i/(PHI*PHI)
    return r*math.cos(theta), r*math.sin(theta)*(flatZ or 1)
end
local function ringPoint(i,n,r,flatZ)
    local theta=2*math.pi*(i-1)/n
    return r*math.cos(theta), r*math.sin(theta)*(flatZ or 1)
end

-- pommel (55)
do
    local base=-56
    for i=1,22 do local x,z=ringPoint(i,22,9.5,0.32)
        table.insert(TARGETS,{x=x,y=base+(i%3)*1.2,z=z}) end
    for i=1,16 do local x,z=ringPoint(i,16,5.8,0.32)
        table.insert(TARGETS,{x=x,y=base+1+(i%2)*1.0,z=z}) end
    for i=1,17 do local x,z=sunflower(i,17,3.8,0.32)
        table.insert(TARGETS,{x=x,y=base+2+(i%3)*0.6,z=z}) end
end
