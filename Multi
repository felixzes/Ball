        table.insert(TARGETS,{x=6+lt*9,y=-38-lt*7,z=((i%3)-1)*0.8}) end
end
-- blade (291)
do
    local n=291; local yMin=-22; local yMax=60; local yRange=yMax-yMin
    local function hw(y)
        local t=math.clamp((y-yMin)/yRange,0,1)
        local bodyT=math.min(t,(38-yMin)/yRange)/((38-yMin)/yRange)
        local tipT=math.max(0,(t-(38-yMin)/yRange)/((yMax-38)/yRange))
        local hx=14-bodyT*9; hx=hx*(1-tipT)
        local hd=2.4-bodyT*1.3; hd=math.max(0,hd*(1-tipT^0.6))
        return hx,hd
    end
    local placed=0; local rowCount=math.ceil(yRange/(yRange/n))
    for row=0,rowCount-1 do
        if placed>=n then break end
        local lt=row/(rowCount-1); local y=yMin+lt*yRange
        local hx,hd=hw(y); if hx<0.05 then break end
        local rowN=math.min(math.max(1,math.floor((1-lt*0.7)*3.2+0.5)),n-placed)
        for j=1,rowN do
            local mode=(placed*3+j)%10; local x,z
            if mode<4 then
                local side=(j%2==0)and 1 or -1
                x=side*(hx*0.88+((placed*17+j)%10)/10*1.2); z=((j%3)-1)*hd*0.5
            elseif mode<6 then
                x=(((placed*13+j)%100)/100-0.5)*hx*1.6
                z=(j%2==0 and 1 or -1)*(hd*0.82+((j*7)%10)/10*0.2)
            elseif mode<7 then
                x=(((placed*11+j)%100)/100-0.5)*hx*0.25
                z=(((placed*9+j)%100)/100-0.5)*0.22
            else
                local fx,fz=sunflower(placed+j,n,1,1)
                x=fx*hx*0.75; z=fz*hd*0.75
            end
            table.insert(TARGETS,{x=x,y=y,z=z}); placed=placed+1
            if placed>=n then break end
        end
    end
    while placed<n do table.insert(TARGETS,{x=0,y=yMax,z=0}); placed=placed+1 end
end

