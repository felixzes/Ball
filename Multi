local sjActive = false
local sjTouch  = nil
local sjOrigin = Vector2.new()
local sjDelta  = Vector2.new()

local function ck(delta,maxR)
    local m = delta.Magnitude
    return m > maxR and (delta/m*maxR) or delta
end

SP.InputBegan:Connect(function(inp)
    if (inp.UserInputType==Enum.UserInputType.Touch
    or  inp.UserInputType==Enum.UserInputType.MouseButton1) and not sjActive then
        sjActive = true; sjTouch = inp
        sjOrigin = Vector2.new(inp.Position.X, inp.Position.Y)
    end
end)
UserInputService.InputChanged:Connect(function(inp)
    if sjActive and inp==sjTouch then
        local d = Vector2.new(inp.Position.X,inp.Position.Y) - sjOrigin
        local c = ck(d,45); sjDelta = c
        SK.Position = UDim2.new(0.5,c.X-19,0.5,c.Y-19)
    end
end)
UserInputService.InputEnded:Connect(function(inp)
    if inp==sjTouch then
        sjActive = false; sjTouch = nil; sjDelta = Vector2.new()
        SK.Position = UDim2.new(0.5,-19,0.5,-19)
    end
end)

RunService.Heartbeat:Connect(function()
    if not sjActive then return end
    for _,sw in ipairs(swords) do
        if sw.enabled then
            sw.yaw   = sw.yaw + sjDelta.X * 0.022
            sw.pitch = math.clamp(
                sw.pitch + sjDelta.Y * 0.022,
                -math.pi*0.88, math.pi*0.88
            )
        end
    end
    allYawDeg   = math.floor(math.deg(swords[1].yaw)%360+0.5)
    allPitchDeg = math.floor(math.deg(swords[1].pitch)+0.5)
end)

