            sw.anchor.Position = sw.centerPos
        end
    end
end)

-- ─── World ray resolver — flat plane only, no raycast ────────────────────────
-- always intersects a horizontal plane at the given Y
-- this is what keeps parts from jumping up/down when the ray hits terrain
local function screenToWorld(sp, planeY)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local ray = cam:ScreenPointToRay(sp.X, sp.Y)
    local d   = ray.Direction
    if math.abs(d.Y) < 0.0001 then
        -- ray nearly horizontal — project forward flat
        return ray.Origin + d * 200
    end
    local t = (planeY - ray.Origin.Y) / d.Y
    if t <= 0 then
        -- plane is behind the camera — project forward
        return ray.Origin + d * 200
    end
    return ray.Origin + d * t
end

