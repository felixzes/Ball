        local lt=(i-1)/29; local yOff=-48+lt*8
        local wrap=math.sin(lt*math.pi*5)*0.7
        local theta=2*math.pi*i/PHI; local r=2.2+wrap
        table.insert(TARGETS,{x=r*math.cos(theta),y=yOff,z=r*math.sin(theta)*0.45})
    end
end
