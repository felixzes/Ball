        local bx=u^3*(8)+3*u^2*lt*(26)+3*u*lt^2*(28)+lt^3*(20)
        local by=u^3*(-36)+3*u^2*lt*(-34)+3*u*lt^2*(-26)+lt^3*(-22)
        local thick=(1-lt)*3.2+0.5; local j=(i*6271)%100/100-0.5
        table.insert(TARGETS,{x=bx+j*thick,y=by+j*1.2,z=((i%3)-1)*0.9})
