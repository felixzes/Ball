-- pulse loop
local pulseConn
local function startPulse()
    local t = 0
    pulseConn = RunService.Heartbeat:Connect(function(dt)
        t = t + dt
        local scale = 1 + math.sin(t * 3) * 0.08
        ballPart.Size = Vector3.new(
            CFG.ballRadius*2*scale,
            CFG.ballRadius*2*scale,
            CFG.ballRadius*2*scale
        )
        ballLight.Brightness = 4 + math.sin(t*4)*2
    end)
end
startPulse()

-- ─── Trail system ─────────────────────────────────────────────────────────────
local trailFolder = Instance.new("Folder", Workspace)
trailFolder.Name  = "SingularityTrail"

local function makeTrailSegment(a, b)
    local mid  = (a + b) / 2
    local dist = (b - a).Magnitude
    if dist < 0.1 then return nil end

    local seg = Instance.new("Part", trailFolder)
    seg.Anchored     = true
    seg.CanCollide   = false
    seg.CastShadow   = false
    seg.Material     = Enum.Material.Neon
    seg.Color        = CFG.trailColor
    seg.Size         = Vector3.new(CFG.trailWidth, CFG.trailWidth, dist)
    seg.CFrame       = CFrame.new(mid, b)

    -- fade out
    local born = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not seg or not seg.Parent then conn:Disconnect() return end
        local age = os.clock() - born
        if age >= CFG.trailLifetime then
            seg:Destroy()
            conn:Disconnect()
            return
        end
        local alpha = 1 - (age / CFG.trailLifetime)
        seg.Transparency = 1 - alpha
        -- color lerp purple → dark
        seg.Color = CFG.trailColor:Lerp(CFG.trailColor2, 1 - alpha)
    end)

    return seg
end

local lastTrailPos = ballPos
local MIN_TRAIL_DIST = 1.2

local function updateTrail()
    local dist = (ballPos - lastTrailPos).Magnitude
    if dist < MIN_TRAIL_DIST then return end

    makeTrailSegment(lastTrailPos, ballPos)
    lastTrailPos = ballPos

    -- trim old nodes
    if #trailParts > CFG.trailLength then
        local old = table.remove(trailParts, 1)
        if old and old.Parent then old:Destroy() end
    end
end

-- ─── Part eligibility ─────────────────────────────────────────────────────────
local function isEligible(p)
    if not p:IsA("BasePart") then return false end
    if p.Anchored then return false end
    if not p:IsDescendantOf(Workspace) then return false end
    if p == ballPart then return false end
    if p:IsDescendantOf(ballFolder) then return false end
    if p:IsDescendantOf(trailFolder) then return false end
    if LocalPlayer.Character and p:IsDescendantOf(LocalPlayer.Character) then return false end
    local a = p.Parent
    while a and a ~= Workspace do
        if a:FindFirstChild("Humanoid") then return false end
        a = a.Parent
    end
    return true
end

-- ─── Pull engine ─────────────────────────────────────────────────────────────
RunService.Heartbeat:Connect(function(dt)
    if not CFG.enabled then return end

    -- move ball visual
    ballPart.Position = ballPos

    -- trail
    updateTrail()

    -- pull all eligible parts toward ball
    for _, p in ipairs(Workspace:GetDescendants()) do
        if isEligible(p) then
            local diff = ballPos - p.Position
            local dist = diff.Magnitude
            if dist < CFG.pullRadius and dist > CFG.ballRadius then
                -- retain via network
                if not table.find(getgenv().SingNet.parts, p) then
                    table.insert(getgenv().SingNet.parts, p)
                    p.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)
                    p.CanCollide = false
                end
                local strength = CFG.pullForce * (1 - dist / CFG.pullRadius)
                p.AssemblyLinearVelocity = p.AssemblyLinearVelocity + diff.Unit * strength * dt
            end
        end
    end
end)

-- ─── Screen to world ─────────────────────────────────────────────────────────
local function screenToWorld(sp, planeY)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local ray = cam:ScreenPointToRay(sp.X, sp.Y)
    local d   = ray.Direction
    if math.abs(d.Y) < 0.0001 then return nil end
    local t = (planeY - ray.Origin.Y) / d.Y
    if t <= 0 then return nil end
    return ray.Origin + d * t
end

