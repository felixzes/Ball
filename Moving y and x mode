-- point 16
for i=1,16 do
    local lt=(i-1)/15; local y=54+lt*4; local hw,hd=bp(y)
    hw=math.max(0.03,hw); local a=2*math.pi*i/PHI; local r=math.sqrt((i-0.5)/16)
