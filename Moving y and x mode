-- ─── 500-point anatomical sword shape ────────────
local TARGETS = {}
local PHI = (1 + math.sqrt(5)) / 2

local function jit(i, salt)
    return ((i * 1619 + salt * 1013) % 1000) / 500 - 1
end
local function sun(i, n, R, flat)
    local r = R * math.sqrt(i / n)
    local a = 2 * math.pi * i / (PHI * PHI)
    return r * math.cos(a), r * math.sin(a) * (flat or 1)
end
local function bez(t, p0, p1, p2, p3)
    local u = 1 - t
    return u^3*p0 + 3*u^2*t*p1 + 3*u*t^2*p2 + t^3*p3
end
local function ring(i, n, r, flat)
    local a = 2 * math.pi * (i-1) / n
    return r * math.cos(a), r * math.sin(a) * (flat or 1)
end

