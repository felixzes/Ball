-- pad to 500
while #TARGETS < 500 do table.insert(TARGETS,{x=0,y=60,z=0}) end
if #TARGETS > 500 then for i=#TARGETS,501,-1 do TARGETS[i]=nil end end

local function getSlot(i)
    return TARGETS[((i-1)%500)+1]
end

-- ─── part pool ───────────────────────────────────
local parts    = {}
local partTrails = {}  -- part → Trail instance

local function isEligible(p)
    if not p:IsA("BasePart")               then return false end
    if p.Anchored                           then return false end
    if not p:IsDescendantOf(Workspace)     then return false end
    if p:IsDescendantOf(Folder)            then return false end
    if LocalPlayer.Character and p:IsDescendantOf(LocalPlayer.Character) then return false end
    local a = p.Parent
    while a and a ~= Workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
        a = a.Parent
    end
    return true
end

-- trail colors cycle
local TRAIL_COLORS = {
    Color3.fromRGB(220,  60,  60),
    Color3.fromRGB(220, 140,  40),
    Color3.fromRGB(220, 220,  40),
    Color3.fromRGB( 80, 200,  80),
    Color3.fromRGB( 60, 160, 220),
    Color3.fromRGB(160,  60, 220),
}
local trailIdx = 0

local function addTrail(part)
    if partTrails[part] then return end
    trailIdx = (trailIdx % #TRAIL_COLORS) + 1
    local col = TRAIL_COLORS[trailIdx]

    -- two attachments at opposite ends of the part
    local a0 = Instance.new("Attachment", part)
    local a1 = Instance.new("Attachment", part)
    a0.Position = Vector3.new(0,  0.5, 0)
    a1.Position = Vector3.new(0, -0.5, 0)

    local trail = Instance.new("Trail", part)
    trail.Attachment0   = a0
    trail.Attachment1   = a1
    trail.Lifetime      = 0.35
    trail.MinLength     = 0
    trail.FaceCamera    = true
    trail.WidthScale    = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    })
    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, col),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,255)),
    })
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1.0),
    })
    partTrails[part] = trail
end

local function removeTrail(part)
    local t = partTrails[part]
    if t and t.Parent then t:Destroy() end
    partTrails[part] = nil
end

local function claimPart(p)
    p.CanCollide   = false
    pcall(function() p.Massless = true end)
    p.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)
    pcall(function() p:SetNetworkOwner(LocalPlayer) end)
    -- strip movers that would resist
    for _, ch in ipairs(p:GetChildren()) do
        if ch:IsA("BodyMover") or ch:IsA("AlignPosition")
        or ch:IsA("AlignOrientation") or ch:IsA("LinearVelocity")
        or ch:IsA("AngularVelocity") or ch:IsA("VectorForce")
        or ch:IsA("Torque") then
            pcall(function() ch:Destroy() end)
        end
    end
end

local function addPart(p)
    if not isEligible(p) then return end
    if table.find(parts, p) then return end
    claimPart(p)
    addTrail(p)
    table.insert(parts, p)
end

local function removePart(p)
    local idx = table.find(parts, p)
    if idx then
        table.remove(parts, idx)
        removeTrail(p)
        partTrails[p] = nil
    end
end

-- initial sweep
for _, obj in ipairs(Workspace:GetDescendants()) do addPart(obj) end
Workspace.DescendantAdded:Connect(addPart)
Workspace.DescendantRemoving:Connect(removePart)

-- periodic re-sweep to catch new parts
local sweepT = 0
RunService.Stepped:Connect(function(_, dt)
    sweepT = sweepT + dt
    if sweepT < 1 then return end
    sweepT = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored then addPart(obj) end
    end
    -- re-strip movers every second so games can't fight back
    for _, p in ipairs(parts) do
        if p and p.Parent then claimPart(p) end
    end
end)

-- ─── follow position ─────────────────────────────
local function getFollowPos()
    if not hrp then return centerPos end
    local cf   = hrp.CFrame
    local left = -cf.RightVector
    return cf.Position + left * LEFT_STUDS
end

-- ─── shape engine ────────────────────────────────
-- direct velocity assignment — fastest possible pull
RunService.Heartbeat:Connect(function()
    local c   = centerPos
    local cnt = #parts
    for i, part in ipairs(parts) do
        if part and part.Parent and not part.Anchored then
            local s   = getSlot(i)
            local tgt = Vector3.new(c.X + s.x, c.Y + s.y, c.Z + s.z)
            local dir = tgt - part.Position
            local dist = dir.Magnitude
            if dist > SNAP_DIST then
                part.Velocity = (dir / dist) * PULL_SPEED
            else
                part.Velocity    = Vector3.zero
                part.RotVelocity = Vector3.zero
            end
        end
    end
end)

-- ─── follow engine ────────────────────────────────
local fingerActive = false

RunService.Heartbeat:Connect(function()
    if fingerActive then return end
    centerPos       = getFollowPos()
    Anchor.Position = centerPos
end)

-- ─── finger drag ─────────────────────────────────
local dragTouch = nil
local dragLockedY = 0

local function screenToWorldY(sp, planeY)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local ray = cam:ScreenPointToRay(sp.X, sp.Y)
    local d   = ray.Direction
    if math.abs(d.Y) < 0.0001 then return ray.Origin + d * 300 end
    local t = (planeY - ray.Origin.Y) / d.Y
    if t <= 0 then return ray.Origin + d * 300 end
    return ray.Origin + d * t
end

