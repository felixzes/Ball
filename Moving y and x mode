sphereBtn.MouseButton1Click:Connect(function()
    sphereOn = not sphereOn
    sphereBtn.Text             = sphereOn and "Sphere: ON" or "Sphere: OFF"
    sphereBtn.BackgroundColor3 = sphereOn and Color3.fromRGB(50,205,50) or Color3.fromRGB(255,0,0)
    if sphereOn then
        centerPos = getFollowPos()
    else
        -- zero all velocities when turned off
        for _, p in ipairs(parts) do
            if p and p.Parent then
                pcall(function() p.Velocity = Vector3.zero end)
            end
        end
    end
end)

