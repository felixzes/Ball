sg.Name = "PullSphereGui"; sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true
sg.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- fullscreen drag overlay
local overlay = Instance.new("Frame")
overlay.Size                   = UDim2.new(1,0,1,0)
overlay.BackgroundTransparency = 1
overlay.BorderSizePixel        = 0
overlay.ZIndex                 = 1
overlay.Parent                 = sg

-- finger dot
local dot = Instance.new("Frame")
dot.Size             = UDim2.new(0,28,0,28)
dot.AnchorPoint      = Vector2.new(0.5,0.5)
dot.BackgroundColor3 = Color3.fromRGB(80,200,255)
dot.BackgroundTransparency = 0.2
dot.BorderSizePixel  = 0
dot.Visible          = false
dot.ZIndex           = 20
dot.Parent           = sg
Instance.new("UICorner",dot).CornerRadius = UDim.new(1,0)

overlay.InputBegan:Connect(function(inp)
    if inp.UserInputType ~= Enum.UserInputType.Touch
    and inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if fingerActive then return end
    fingerActive = true; dragTouch = inp
    dragLockedY  = centerPos.Y
    local sp = Vector2.new(inp.Position.X, inp.Position.Y)
    local wp = screenToWorldY(sp, dragLockedY)
    if wp then centerPos = Vector3.new(wp.X, dragLockedY, wp.Z) end
    dot.Position = UDim2.new(0, sp.X, 0, sp.Y); dot.Visible = true
end)

UserInputService.InputChanged:Connect(function(inp)
    if not fingerActive or inp ~= dragTouch then return end
    if inp.UserInputType ~= Enum.UserInputType.Touch
    and inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local sp = Vector2.new(inp.Position.X, inp.Position.Y)
    local wp = screenToWorldY(sp, dragLockedY)
    if wp then centerPos = Vector3.new(wp.X, dragLockedY, wp.Z) end
    dot.Position = UDim2.new(0, sp.X, 0, sp.Y)
end)

UserInputService.InputEnded:Connect(function(inp)
    if inp ~= dragTouch then return end
    fingerActive = false; dragTouch = nil; dot.Visible = false
    centerPos = getFollowPos()
end)

