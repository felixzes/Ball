-- ════════════════════════════════════════════════════════════════════════════
--  POSITION ENGINE — always camera-left, HRP Y locked
-- ════════════════════════════════════════════════════════════════════════════

local function getLeft()
    if not humanoidRootPart then return Vector3.new(1,0,0) end
    local cam  = Workspace.CurrentCamera
    local look = cam and cam.CFrame.LookVector or humanoidRootPart.CFrame.LookVector
    look = Vector3.new(look.X,0,look.Z)
    if look.Magnitude < 0.001 then look = Vector3.new(0,0,1) end
    look = look.Unit
    return Vector3.new(-look.Z,0,look.X)
end

local function getSidePos(si)
    if not humanoidRootPart then return Vector3.new() end
    local left = getLeft()
    local dist = 45 + (si-1)*4
    local hrp  = humanoidRootPart.Position
    return Vector3.new(hrp.X + left.X*dist, hrp.Y, hrp.Z + left.Z*dist)
end

-- ════════════════════════════════════════════════════════════════════════════
--  MODE SYSTEM
-- ════════════════════════════════════════════════════════════════════════════
local MODES       = {"Formation","Orbit","Vortex","Blackhole","Storm","Shield"}
local currentMode = "Formation"
local modeTime    = 0

local BH_RING_RADII  = {0,18,18,18,36,36,36,36}
local BH_RING_ANGLES = {0,0,120,240,0,90,180,270}
local bhCenter       = Vector3.new()
local bhDragging     = false
local bhDragTouch    = nil
local bhSuckRadius   = 60
local bhSuckForce    = 180
local bhSpinSpeed    = 2.0

local function getFormationPos(si)
    return getSidePos(si)
end

local function getOrbitPos(si,t)
    if not humanoidRootPart then return Vector3.new() end
    local base  = getSidePos(1)
    local angle = t*1.2 + (si-1)*(2*math.pi/8)
    local r     = 10
    return Vector3.new(base.X+math.cos(angle)*r, humanoidRootPart.Position.Y, base.Z+math.sin(angle)*r)
end

local function getVortexPos(si,t)
    if not humanoidRootPart then return Vector3.new() end
    local base  = getSidePos(1)
    local angle = t*2.5 + (si-1)*(2*math.pi/8)
    local r     = 6 + (si-1)*2
    return Vector3.new(base.X+math.cos(angle)*r, humanoidRootPart.Position.Y, base.Z+math.sin(angle)*r)
end

local function getBlackholePos(si,t)
    local ringR   = BH_RING_RADII[si]
    local baseAng = math.rad(BH_RING_ANGLES[si])
    local spin    = si==1 and 0 or (ringR<=20 and t*bhSpinSpeed or -t*bhSpinSpeed*0.6)
    local angle   = baseAng+spin
    return Vector3.new(bhCenter.X+math.cos(angle)*ringR, bhCenter.Y, bhCenter.Z+math.sin(angle)*ringR)
end

local function getStormPos(si,t)
    if not humanoidRootPart then return Vector3.new() end
    local base  = getSidePos(1)
    local angle = t*4 + (si-1)*(2*math.pi/8)
    local r     = 5
    return Vector3.new(base.X+math.cos(angle)*r, humanoidRootPart.Position.Y, base.Z+math.sin(angle)*r)
end

local function getShieldPos(si,t)
    if not humanoidRootPart then return Vector3.new() end
    local base  = getSidePos(1)
    local angle = (si-1)*(2*math.pi/8) + t*0.4
    local r     = 10
    return Vector3.new(base.X+math.cos(angle)*r, humanoidRootPart.Position.Y, base.Z+math.sin(angle)*r)
end

local function getTargetPos(si,t)
    if currentMode=="Formation"  then return getFormationPos(si)
    elseif currentMode=="Orbit"  then return getOrbitPos(si,t)
    elseif currentMode=="Vortex" then return getVortexPos(si,t)
    elseif currentMode=="Blackhole" then return getBlackholePos(si,t)
    elseif currentMode=="Storm"  then return getStormPos(si,t)
    elseif currentMode=="Shield" then return getShieldPos(si,t)
    end
    return getFormationPos(si)
end

-- ════════════════════════════════════════════════════════════════════════════
--  SWORD SYSTEM
-- ════════════════════════════════════════════════════════════════════════════
local SWORD_COUNT      = 8
local partOwner        = {}
local partCounter      = 0
local activeSwordCount = 8
local swords           = {}

local function tagName(si,k) return ("DB_%d_%s"):format(si,k) end

local function isEligible(p)
    if not p:IsA("BasePart") then return false end
    if p.Anchored then return false end
    if not p:IsDescendantOf(Workspace) then return false end
    for _,sw in ipairs(swords) do
        if sw.folder and p:IsDescendantOf(sw.folder) then return false end
    end
    if LocalPlayer.Character and p:IsDescendantOf(LocalPlayer.Character) then return false end
    local a=p.Parent
    while a and a~=Workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
        a=a.Parent
    end
    return true
end

local function cleanPart(p,si)
    if not p or not p.Parent then return end
    for _,n in ipairs({tagName(si,"Att"),tagName(si,"AP"),tagName(si,"AO")}) do
        local c=p:FindFirstChild(n) if c then c:Destroy() end
    end
end

local function forcePart(p,sw)
    local si=sw.slotIndex
    for _,x in next,p:GetChildren() do
        if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
        or x:IsA("BodyPosition") or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
        or x:IsA("RocketPropulsion") then x:Destroy() end
    end
    cleanPart(p,si)
    p.CanCollide=false
    local att=Instance.new("Attachment",p) att.Name=tagName(si,"Att")
    local ancAtt=Instance.new("Attachment",sw.anchor)
    ancAtt.Name=tagName(si,"AncAtt").."_"..tostring(p:GetDebugId())
    local ap=Instance.new("AlignPosition",p) ap.Name=tagName(si,"AP")
    ap.MaxForce=math.huge ap.MaxVelocity=math.huge ap.Responsiveness=200
    ap.Attachment0=att ap.Attachment1=ancAtt
    local ao=Instance.new("AlignOrientation",p) ao.Name=tagName(si,"AO")
    ao.MaxAngularVelocity=math.huge ao.MaxTorque=math.huge ao.Responsiveness=200
    ao.Attachment0=att ao.Attachment1=ancAtt
    sw._anchorAtts[p]=ancAtt
end

local function createSword(slotIndex)
    local sw={}
    sw.slotIndex=slotIndex sw.enabled=true
    sw.fingerActive=false sw.fingerTouch=nil
    sw.yaw=0 sw.pitch=0 sw.parts={} sw._anchorAtts={}
    sw.centerPos=humanoidRootPart and humanoidRootPart.Position or Vector3.new()
    sw.folder=Instance.new("Folder",Workspace) sw.folder.Name="DB_SW"..slotIndex
    sw.anchor=Instance.new("Part",sw.folder)
    sw.anchor.Anchored=true sw.anchor.CanCollide=false
    sw.anchor.Transparency=1 sw.anchor.Size=Vector3.new(1,1,1)
    sw.anchor.Position=sw.centerPos
    sw.rot=function(x,y,z)
        local cy,sy=math.cos(sw.yaw),math.sin(sw.yaw)
        local cp,sp=math.cos(sw.pitch),math.sin(sw.pitch)
        local rx=cy*x-sy*z local rz=sy*x+cy*z
        return rx,cp*y-sp*rz,sp*y+cp*rz
    end
    sw.removePart=function(p)
        local idx=table.find(sw.parts,p) if idx then table.remove(sw.parts,idx) end
        if partOwner[p]==slotIndex then partOwner[p]=nil end
        cleanPart(p,slotIndex)
        if sw._anchorAtts[p] then sw._anchorAtts[p]:Destroy() sw._anchorAtts[p]=nil end
    end
    sw.addPart=function(p)
        if not sw.enabled then return end
        if not isEligible(p) then return end
        if table.find(sw.parts,p) then return end
        local owner=partOwner[p]
        if owner==nil then
            if activeSwordCount==0 then return end
            partCounter=partCounter+1
            local assigned=((partCounter-1)%activeSwordCount)+1
            partOwner[p]=assigned owner=assigned
        end
        if owner~=slotIndex then return end
        if getgenv().Network then getgenv().Network.RetainPart(p) end
        forcePart(p,sw) table.insert(sw.parts,p)
    end
    return sw
end

for i=1,SWORD_COUNT do table.insert(swords,createSword(i)) end

local function resetPartitions()
    for _,sw in ipairs(swords) do
        for _,p in ipairs(sw.parts) do
            cleanPart(p,sw.slotIndex)
            if sw._anchorAtts[p] then sw._anchorAtts[p]:Destroy() sw._anchorAtts[p]=nil end
        end
        sw.parts={}
        for _,ch in ipairs(sw.anchor:GetChildren()) do
            if ch:IsA("Attachment") then ch:Destroy() end
        end
        sw._anchorAtts={}
    end
    partOwner={} partCounter=0
    if activeSwordCount==0 then return end
    local pool={}
    for _,p in ipairs(Workspace:GetDescendants()) do
        if isEligible(p) then table.insert(pool,p) end
    end
    for i,p in ipairs(pool) do
        local assigned=((i-1)%activeSwordCount)+1
        partOwner[p]=assigned partCounter=i
        local sw=swords[assigned]
        if sw.enabled then
            if getgenv().Network then getgenv().Network.RetainPart(p) end
            forcePart(p,sw) table.insert(sw.parts,p)
        end
    end
end

local function globalAdd(p)
    if activeSwordCount==0 then return end
    if partOwner[p] then
        local sw=swords[partOwner[p]]
        if sw and sw.enabled and not table.find(sw.parts,p) and isEligible(p) then
            forcePart(p,sw) table.insert(sw.parts,p)
        end
        return
    end
    if not isEligible(p) then return end
    partCounter=partCounter+1
    local assigned=((partCounter-1)%activeSwordCount)+1
    partOwner[p]=assigned
    local sw=swords[assigned]
    if sw and sw.enabled then
        if getgenv().Network then getgenv().Network.RetainPart(p) end
        forcePart(p,sw) table.insert(sw.parts,p)
    end
end

local function globalRemove(p)
    local si=partOwner[p]
    if si then local sw=swords[si] if sw then sw.removePart(p) end end
    partOwner[p]=nil
end

Workspace.DescendantAdded:Connect(function(p) task.defer(function() globalAdd(p) end) end)
Workspace.DescendantRemoving:Connect(globalRemove)

local _sc=0
RunService.Heartbeat:Connect(function(dt)
    _sc=_sc+dt if _sc<2 then return end _sc=0
    for _,p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored and not partOwner[p] then globalAdd(p) end
    end
end)

-- ─── Main loop ───────────────────────────────────────────────────────────────
RunService.Heartbeat:Connect(function(dt)
    modeTime=modeTime+dt

    if currentMode=="Blackhole" then
        for _,sw in ipairs(swords) do
            if not sw.enabled then continue end
            local center=sw.anchor.Position
            for _,p in ipairs(Workspace:GetDescendants()) do
                if p:IsA("BasePart") and not p.Anchored and isEligible(p) then
                    local diff=center-p.Position
                    local dist=diff.Magnitude
                    if dist<bhSuckRadius and dist>0.5 then
                        local force=diff.Unit*bhSuckForce*(1-dist/bhSuckRadius)
                        p.AssemblyLinearVelocity=p.AssemblyLinearVelocity+force*dt
                    end
                end
            end
        end
    end

    for i,sw in ipairs(swords) do
        if not sw.enabled then continue end
        if currentMode=="Blackhole" then
            if not bhDragging then
                sw.centerPos=getBlackholePos(i,modeTime)
                sw.anchor.Position=sw.centerPos
            end
        elseif not sw.fingerActive then
            sw.centerPos=getTargetPos(i,modeTime)
            sw.anchor.Position=sw.centerPos
        end
        local ancPos=sw.anchor.Position
        local idx=0
        for _,part in ipairs(sw.parts) do
            if part.Parent and not part.Anchored then
                idx=idx+1
                local s=getSlot(idx)
                local rx,ry,rz=sw.rot(s.x,s.y,s.z)
                local target=ancPos+Vector3.new(rx,ry,rz)
                local ancAtt=sw._anchorAtts[part]
                if ancAtt then ancAtt.WorldPosition=target end
            end
        end
    end
end)

