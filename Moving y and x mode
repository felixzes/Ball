--[[
    PullSphere.lua
    - pulls every unanchored part into a sphere around you
    - trail on every part: toggle button (white, subtle)
    - finger drag to move sphere, release snaps back left
    - no joystick
]]

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local SoundService     = game:GetService("SoundService")
local Workspace        = game:GetService("Workspace")
local LocalPlayer      = Players.LocalPlayer

local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local hrp       = character:WaitForChild("HumanoidRootPart")

-- ─── network ─────────────────────────────────────
if not getgenv().Network then
    getgenv().Network = { BaseParts = {} }
    local N = getgenv().Network
    N.RetainPart = function(p)
        if typeof(p)=="Instance" and p:IsA("BasePart") and p:IsDescendantOf(Workspace) then
            if not table.find(N.BaseParts,p) then
                table.insert(N.BaseParts,p)
                p.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)
                p.CanCollide = false
            end
        end
    end
    LocalPlayer.ReplicationFocus = Workspace
    RunService.Heartbeat:Connect(function()
        pcall(function()
            sethiddenproperty(LocalPlayer,"SimulationRadius",    2147483647)
            sethiddenproperty(LocalPlayer,"MaxSimulationRadius", 2147483647)
        end)
    end)
end

-- ─── state ───────────────────────────────────────
local radius     = 50
local PULL_SPEED = 9999
local SNAP_DIST  = 1.5
local LEFT_STUDS = 14
local trailsOn   = false
local sphereOn   = false
local centerPos  = hrp.Position
local PHI        = (1 + math.sqrt(5)) / 2

local parts      = {}       -- ordered list of claimed parts
local partTrails = {}       -- part → { trail, a0, a1 }

-- ─── sphere target positions (sunflower/Fibonacci) ──
local function getSphereTarget(i, count, center)
    local n   = math.max(count, 1)
    local phi = math.acos(1 - 2 * i / n)
    local theta = math.pi * (1 + math.sqrt(5)) * i
    return Vector3.new(
        center.X + radius * math.sin(phi) * math.cos(theta),
        center.Y + radius * math.cos(phi),
        center.Z + radius * math.sin(phi) * math.sin(theta)
    )
end

-- ─── trail helpers ───────────────────────────────
local function addTrail(part)
    if partTrails[part] then return end
    local a0 = Instance.new("Attachment", part)
    local a1 = Instance.new("Attachment", part)
    a0.Position = Vector3.new(0,  0.5, 0)
    a1.Position = Vector3.new(0, -0.5, 0)
    local tr = Instance.new("Trail", part)
    tr.Attachment0   = a0
    tr.Attachment1   = a1
    tr.Lifetime      = 0.3
    tr.MinLength     = 0
    tr.FaceCamera    = true
    tr.Color         = ColorSequence.new(Color3.fromRGB(255,255,255))
    tr.Transparency  = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2),
        NumberSequenceKeypoint.new(1, 1.0),
    })
    tr.WidthScale    = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    })
    tr.Enabled = trailsOn
    partTrails[part] = { trail = tr, a0 = a0, a1 = a1 }
end

local function removeTrail(part)
    local d = partTrails[part]
    if not d then return end
    pcall(function() d.trail:Destroy() end)
    pcall(function() d.a0:Destroy()   end)
    pcall(function() d.a1:Destroy()   end)
    partTrails[part] = nil
end

local function setAllTrails(on)
    trailsOn = on
    for _, d in pairs(partTrails) do
        if d.trail and d.trail.Parent then
            d.trail.Enabled = on
        end
    end
end

-- ─── part eligibility ────────────────────────────
local function isEligible(p)
    if not p:IsA("BasePart")               then return false end
    if p.Anchored                           then return false end
    if not p:IsDescendantOf(Workspace)     then return false end
    local c = LocalPlayer.Character
    if c and p:IsDescendantOf(c)           then return false end
    local a = p.Parent
    while a and a ~= Workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
        a = a.Parent
    end
    return true
end

-- ─── claim a part ────────────────────────────────
local function claimPart(p)
    p.CanCollide   = false
    pcall(function() p.Massless = true end)
    p.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)
    pcall(function() p:SetNetworkOwner(LocalPlayer) end)
    for _, ch in ipairs(p:GetChildren()) do
        if ch:IsA("BodyMover") or ch:IsA("AlignPosition")
        or ch:IsA("AlignOrientation") or ch:IsA("LinearVelocity")
        or ch:IsA("AngularVelocity") or ch:IsA("VectorForce")
        or ch:IsA("Torque") then
            pcall(function() ch:Destroy() end)
        end
    end
    if getgenv().Network then getgenv().Network.RetainPart(p) end
end

local function addPart(p)
    if not isEligible(p)       then return end
    if table.find(parts, p)    then return end
    claimPart(p)
    table.insert(parts, p)
    addTrail(p)
end

local function removePart(p)
    local idx = table.find(parts, p)
    if idx then
        table.remove(parts, idx)
        removeTrail(p)
    end
end

-- initial sweep
for _, obj in ipairs(Workspace:GetDescendants()) do addPart(obj) end
Workspace.DescendantAdded:Connect(addPart)
Workspace.DescendantRemoving:Connect(removePart)

-- periodic re-sweep
local sweepT = 0
RunService.Stepped:Connect(function(_, dt)
    sweepT = sweepT + dt
    if sweepT < 1.5 then return end
    sweepT = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored then addPart(obj) end
    end
    for _, p in ipairs(parts) do
        if p and p.Parent then claimPart(p) end
    end
end)

-- ─── sphere shape engine ─────────────────────────
RunService.Heartbeat:Connect(function()
    if not sphereOn then return end
    local c   = centerPos
    local cnt = #parts
    for i, part in ipairs(parts) do
        if part and part.Parent and not part.Anchored then
            local tgt  = getSphereTarget(i, cnt, c)
            local dir  = tgt - part.Position
            local dist = dir.Magnitude
            if dist > SNAP_DIST then
                part.Velocity = (dir / dist) * PULL_SPEED
            else
                part.Velocity    = Vector3.zero
                part.RotVelocity = Vector3.zero
            end
        end
    end
end)

-- ─── follow + finger drag ────────────────────────
local fingerActive = false
local dragTouch    = nil
local dragLockedY  = 0

local function getFollowPos()
    if not hrp then return centerPos end
    local left = -hrp.CFrame.RightVector
    return hrp.Position + left * LEFT_STUDS
end

RunService.Heartbeat:Connect(function()
    if not sphereOn or fingerActive then return end
    centerPos = getFollowPos()
end)

local function screenToWorldY(sp, planeY)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local ray = cam:ScreenPointToRay(sp.X, sp.Y)
    local d   = ray.Direction
    if math.abs(d.Y) < 0.0001 then return ray.Origin + d * 300 end
    local t = (planeY - ray.Origin.Y) / d.Y
    if t <= 0 then return ray.Origin + d * 300 end
    return ray.Origin + d * t
end

