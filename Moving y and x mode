-- blade profile
local BLADE_ROOT_Y=-14; local BLADE_TIP_Y=60
local BLADE_MAX_HW=13.5; local BLADE_MAX_HD=2.2
local function bp(y)
    if y<=BLADE_ROOT_Y then return BLADE_MAX_HW, BLADE_MAX_HD end
    if y>=BLADE_TIP_Y  then return 0.02, 0.02 end
    local bodyEnd=54
    if y<=bodyEnd then
        local t=(y-BLADE_ROOT_Y)/(bodyEnd-BLADE_ROOT_Y)
        return math.max(0.02,BLADE_MAX_HW*(1-t^1.6)), math.max(0.02,BLADE_MAX_HD*(1-t^1.3))
    end
    local t=(y-bodyEnd)/(BLADE_TIP_Y-bodyEnd)
    return math.max(0.02,BLADE_MAX_HW*(1-t)*0.08), math.max(0.02,BLADE_MAX_HD*(1-t)*0.18)
end

