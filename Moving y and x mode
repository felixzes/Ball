-- ─── Drag input ───────────────────────────────────────────────────────────────

dragOverlay.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if not CFG.enabled then return end
    if inp.UserInputType ~= Enum.UserInputType.Touch
    and inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if dragging then return end

    dragging   = true
    dragTouch  = inp
    dragPlaneY = ballPos.Y

    local wp = screenToWorld(Vector2.new(inp.Position.X, inp.Position.Y), dragPlaneY)
    if wp then
        ballPos      = Vector3.new(wp.X, dragPlaneY, wp.Z)
        lastTrailPos = ballPos
        ballPart.Position = ballPos
    end
end)

UserInputService.InputChanged:Connect(function(inp)
    if not dragging or inp ~= dragTouch then return end
    if inp.UserInputType ~= Enum.UserInputType.Touch
    and inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end

    local wp = screenToWorld(Vector2.new(inp.Position.X, inp.Position.Y), dragPlaneY)
    if wp then
        ballPos = Vector3.new(wp.X, dragPlaneY, wp.Z)
        ballPart.Position = ballPos
    end
end)

UserInputService.InputEnded:Connect(function(inp)
    if inp == dragTouch then
        dragging  = false
        dragTouch = nil
    end
end)

