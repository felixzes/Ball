-- ─── Live stat updates ───────────────────────────────────────────────────────
local _statClock=0; local _fpsSamples={}; local _lastHB=tick()
RunService.Heartbeat:Connect(function(dt)
    -- FPS sampling
    local now=tick(); local delta=now-_lastHB; _lastHB=now
    table.insert(_fpsSamples,1/math.max(delta,0.001))
    if #_fpsSamples>20 then table.remove(_fpsSamples,1) end

    _statClock=_statClock+dt
    if _statClock < 0.25 then return end
    _statClock=0

    -- FPS
    local sum=0; for _,v in ipairs(_fpsSamples) do sum=sum+v end
    local fps=math.floor(sum/#_fpsSamples+0.5)
    fpsLbl.Text="FPS: "..fps

    -- Total + per-sword
    local tot=0
    for i,sw in ipairs(swords) do
        local n=#sw.parts; tot=tot+n
        if partCountLabels[i] then partCountLabels[i].Text=n.." pts" end
    end
    totalLbl.Text="Pts: "..tot
end)

