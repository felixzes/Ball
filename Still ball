--  SWORD SYSTEM
-- ════════════════════════════════════════════════════════════════════════════
local SWORD_COUNT      = 8
local partOwner        = {}
local partCounter      = 0
local activeSwordCount = 0
local swords           = {}

local function tagName(si,k) return ("DB4_%d_%s"):format(si,k) end

local function getFollowPos(si)
    if not humanoidRootPart then return Vector3.new(0,0,0) end
    local cam  = Workspace.CurrentCamera
    local look = cam and cam.CFrame.LookVector or humanoidRootPart.CFrame.LookVector
    look = Vector3.new(look.X,0,look.Z)
    if look.Magnitude < 0.001 then look = Vector3.new(1,0,0) else look = look.Unit end
    local left = Vector3.new(-look.Z,0,look.X)
    -- track hip height so formation follows crouch/jump
    local hipY = humanoidRootPart.Position.Y
    return Vector3.new(
        humanoidRootPart.Position.X,
        hipY,
        humanoidRootPart.Position.Z
    ) + left * (CFG.BASE_LEFT_STUDS + (si-1) * CFG.SWORD_SPACING)
end

local function isEligible(p)
    if not p:IsA("BasePart") or p.Anchored then return false end
    if not p:IsDescendantOf(Workspace) then return false end
    for _,sw in ipairs(swords) do
        if sw.folder and p:IsDescendantOf(sw.folder) then return false end
    end
    if LocalPlayer.Character and p:IsDescendantOf(LocalPlayer.Character) then return false end
    local a=p.Parent
    while a and a~=Workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
        a=a.Parent
    end
    return true
end

local function cleanPart(p, si)
    if not p or not p.Parent then return end
    for _,name in ipairs({tagName(si,"Att"),tagName(si,"AP"),tagName(si,"AO")}) do
        local c=p:FindFirstChild(name); if c then c:Destroy() end
    end
end

local function stripMovers(p)
    for _,x in next,p:GetChildren() do
        local cn = x.ClassName
        if cn=="BodyAngularVelocity" or cn=="BodyForce"    or cn=="BodyGyro"
        or cn=="BodyPosition"        or cn=="BodyThrust"   or cn=="BodyVelocity"
        or cn=="RocketPropulsion"    or cn=="LinearVelocity" or cn=="AngularVelocity"
        or cn=="VectorForce"         or cn=="Torque"        or cn=="AlignPosition"
        or cn=="AlignOrientation" then
            pcall(function() x:Destroy() end)
        end
    end
end

local function forcePart(p, sw)
    local si = sw.slotIndex
    stripMovers(p)
    cleanPart(p, si)
    nukePhysics(p)
    retainPart(p)

    local att    = Instance.new("Attachment", p);      att.Name    = tagName(si,"Att")
    local ancAtt = Instance.new("Attachment", sw.anchor)
    ancAtt.Name  = tagName(si,"AncAtt").."_"..tostring(p:GetDebugId())

    local ap          = Instance.new("AlignPosition", p);   ap.Name = tagName(si,"AP")
    ap.MaxForce       = math.huge
    ap.MaxVelocity    = math.huge
    ap.Responsiveness = 200
    ap.Attachment0    = att
    ap.Attachment1    = ancAtt

    local ao                  = Instance.new("AlignOrientation", p); ao.Name = tagName(si,"AO")
    ao.MaxAngularVelocity     = math.huge
    ao.MaxTorque              = math.huge
    ao.Responsiveness         = 200
    ao.Attachment0            = att
    ao.Attachment1            = ancAtt

    sw._anchorAtts[p] = ancAtt
end

local function createSword(slotIndex)
    local sw = {
        slotIndex    = slotIndex,
        enabled      = false,
        fingerActive = false,
        fingerTouch  = nil,
        yaw          = 0,
        pitch        = 0,
        parts        = {},
        centerPos    = humanoidRootPart and humanoidRootPart.Position or Vector3.new(),
        _anchorAtts  = {},
    }
    sw.folder      = Instance.new("Folder", Workspace)
    sw.folder.Name = "DevilsBlade4_SW"..slotIndex
    sw.anchor      = Instance.new("Part", sw.folder)
    sw.anchor.Anchored     = true
    sw.anchor.CanCollide   = false
    sw.anchor.Transparency = 1
    sw.anchor.Size         = Vector3.new(1,1,1)
    sw.anchor.Position     = sw.centerPos

    sw.rot = function(x,y,z)
        local cy,sy = math.cos(sw.yaw),  math.sin(sw.yaw)
        local cp,sp = math.cos(sw.pitch), math.sin(sw.pitch)
        local rx = cy*x-sy*z; local rz = sy*x+cy*z
        return rx, cp*y-sp*rz, sp*y+cp*rz
    end

    sw.removePart = function(p)
        local idx=table.find(sw.parts,p); if idx then table.remove(sw.parts,idx) end
        if partOwner[p]==slotIndex then partOwner[p]=nil end
        cleanPart(p,slotIndex)
        if sw._anchorAtts[p] then
            pcall(function() sw._anchorAtts[p]:Destroy() end)
            sw._anchorAtts[p]=nil
        end
    end

    sw.addPart = function(p)
        if not sw.enabled then return end
        if not isEligible(p) then return end
        if table.find(sw.parts,p) then return end
        local owner=partOwner[p]
        if owner==nil then
            if activeSwordCount==0 then return end
            partCounter=partCounter+1
            local assigned=((partCounter-1)%activeSwordCount)+1
            partOwner[p]=assigned; owner=assigned
        end
        if owner~=slotIndex then return end
        forcePart(p,sw)
        table.insert(sw.parts,p)
    end

    return sw
end

for i=1,SWORD_COUNT do table.insert(swords,createSword(i)) end

-- ─── Partition reset ─────────────────────────────────────────────────────────
local function resetPartitions()
    for _,sw in ipairs(swords) do
        for _,p in ipairs(sw.parts) do
            cleanPart(p,sw.slotIndex)
            if sw._anchorAtts[p] then
                pcall(function() sw._anchorAtts[p]:Destroy() end)
                sw._anchorAtts[p]=nil
            end
        end
        sw.parts={}
        for _,ch in ipairs(sw.anchor:GetChildren()) do
            if ch:IsA("Attachment") then pcall(function() ch:Destroy() end) end
        end
        sw._anchorAtts={}
    end
    partOwner={}; partCounter=0
    N.BaseParts={}
    if activeSwordCount==0 then return end

    local pool={}
    for _,p in ipairs(Workspace:GetDescendants()) do
        if isEligible(p) then table.insert(pool,p) end
    end
    for i,p in ipairs(pool) do
        local assigned=((i-1)%activeSwordCount)+1
        partOwner[p]=assigned; partCounter=i
        local sw=swords[assigned]
        if sw.enabled then forcePart(p,sw); table.insert(sw.parts,p) end
    end
end

-- Global add/remove
local function globalAdd(p)
    if activeSwordCount==0 then return end
    -- Re-wire parts whose constraints got destroyed server-side
    if partOwner[p] then
        local sw=swords[partOwner[p]]
        if sw and sw.enabled then
            local hasAP = p:FindFirstChild(tagName(sw.slotIndex,"AP"))
            if not hasAP and isEligible(p) then
                forcePart(p,sw)
                if not table.find(sw.parts,p) then table.insert(sw.parts,p) end
            end
        end
        return
    end
    if not isEligible(p) then return end
    partCounter=partCounter+1
    local assigned=((partCounter-1)%activeSwordCount)+1
    partOwner[p]=assigned
    local sw=swords[assigned]
    if sw and sw.enabled then forcePart(p,sw); table.insert(sw.parts,p) end
end

local function globalRemove(p)
    local si=partOwner[p]
    if si then local sw=swords[si]; if sw then sw.removePart(p) end end
    partOwner[p]=nil
end

Workspace.DescendantAdded:Connect(function(p) task.defer(function() globalAdd(p) end) end)
Workspace.DescendantRemoving:Connect(globalRemove)

-- Fast sweep: 0.5s, also re-wires broken constraints
local _sweepClock=0
RunService.Heartbeat:Connect(function(dt)
    _sweepClock=_sweepClock+dt
    if _sweepClock < CFG.SWEEP_INTERVAL then return end
    _sweepClock=0
    for _,p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored then
            if not partOwner[p] then
                globalAdd(p)
            else
                -- Re-wire if constraint was destroyed
                local si=partOwner[p]
                local sw=swords[si]
                if sw and sw.enabled then
                    local hasAP=p:FindFirstChild(tagName(si,"AP"))
                    if not hasAP and isEligible(p) then
                        forcePart(p,sw)
                        if not table.find(sw.parts,p) then table.insert(sw.parts,p) end
                    end
                end
            end
        end
    end
end)

-- ════════════════════════════════════════════════════════════════════════════
--  MAXIMUM HOLD ENGINE
--  Three layers:
--  1. Far (>SNAP_THRESHOLD)  → velocity blast, scaled by distance
--  2. Near (≤SNAP_THRESHOLD) → zero velocity + hard teleport to exact slot
--  3. Every frame             → gravity kill + CanCollide=false re-enforced
-- ════════════════════════════════════════════════════════════════════════════
local totalPartsHeld = 0

RunService.Heartbeat:Connect(function()
    local total=0
    for _,sw in ipairs(swords) do
        if not sw.enabled then continue end
        local ancPos = sw.anchor.Position
        local idx    = 0
        for _,part in ipairs(sw.parts) do
            if part.Parent and not part.Anchored then
                idx=idx+1
                total=total+1

                -- Layer 3: re-enforce every frame, no exceptions
                pcall(function()
                    part.CanCollide=false
                    part.CustomPhysicalProperties=PhysicalProperties.new(0,0,0,0,0)
                end)

                local s      = getSlot(idx)
                local rx,ry,rz = sw.rot(s.x,s.y,s.z)
                local target = ancPos + Vector3.new(rx,ry,rz)

                -- Update AlignPosition anchor attachment
                local ancAtt = sw._anchorAtts[part]
                if ancAtt then ancAtt.WorldPosition=target end

                local dist = (part.Position-target).Magnitude

                if dist <= CFG.SNAP_THRESHOLD then
                    -- Layer 2: hard lock — zero velocity AND teleport
                    pcall(function()
                        part.AssemblyLinearVelocity  = Vector3.new(0,0,0)
                        part.AssemblyAngularVelocity = Vector3.new(0,0,0)
                        part.RotVelocity             = Vector3.new(0,0,0)
                        part.CFrame = CFrame.new(target)
                    end)
                else
                    -- Layer 1: velocity blast, scales with distance (faster when further)
                    local speed = math.min(CFG.PULL_SPEED, dist * 1200)
                    local dir   = (target - part.Position).Unit
                    pcall(function()
                        part.Velocity = dir * speed
                        part.AssemblyLinearVelocity = dir * speed
                    end)
                end
            end
        end
    end
    totalPartsHeld = total
end)

-- Follow engine
RunService.Heartbeat:Connect(function()
    for _,sw in ipairs(swords) do
        if sw.enabled and not sw.fingerActive then
            sw.centerPos       = getFollowPos(sw.slotIndex)
            sw.anchor.Position = sw.centerPos
        end
    end
end)

-- Y-locked screen-to-world
local function screenToWorld(sp,planeY)
    local cam=Workspace.CurrentCamera; if not cam then return nil end
    local ray=cam:ScreenPointToRay(sp.X,sp.Y); local d=ray.Direction
    if math.abs(d.Y)<0.0001 then return ray.Origin+d*200 end
    local t=(planeY-ray.Origin.Y)/d.Y
    if t<=0 then return ray.Origin+d*200 end
    return ray.Origin+d*t
end

