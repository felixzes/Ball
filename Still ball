local function retainPart(p)
    if typeof(p) ~= "Instance" or not p:IsA("BasePart") then return end
    if not p:IsDescendantOf(Workspace) then return end
    if table.find(N.BaseParts, p) then return end
    table.insert(N.BaseParts, p)
end

local function nukePhysics(p)
    if not p or not p.Parent then return end
    pcall(function() p.CanCollide   = false end)
    pcall(function() p.Massless     = true  end)
    pcall(function() p.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0) end)
end

