-- ─── FINGER DRAG MODE
-- Tap/drag anywhere on screen (outside GUI/joysticks).
-- Raycasts into world, moves center to hit position.
-- Y is preserved from current center so it floats level.
-- ═══════════════════════════════════════════════════════
local fingerDragEnabled  = false
local fingerDragActive   = false
local fingerDragTouchId  = nil

-- overlay frame — invisible, covers full screen, sits behind gui
local FingerDragOverlay = Instance.new("Frame")
FingerDragOverlay.Size                   = UDim2.new(1,0,1,0)
FingerDragOverlay.Position               = UDim2.new(0,0,0,0)
FingerDragOverlay.BackgroundTransparency = 1
FingerDragOverlay.BorderSizePixel        = 0
