       and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if fingerDragActive then return end
    fingerDragActive  = true
    fingerDragTouchId = input
    applyFingerDragPosition(Vector2.new(input.Position.X, input.Position.Y))
end)

