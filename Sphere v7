FingerDragOverlay.Visible                = false
FingerDragOverlay.Parent                 = ScreenGui

-- visual crosshair dot that follows finger
local FingerDot = Instance.new("Frame")
FingerDot.Size                   = UDim2.new(0,24,0,24)
FingerDot.AnchorPoint            = Vector2.new(0.5,0.5)
FingerDot.Position               = UDim2.new(0.5,0,0.5,0)
FingerDot.BackgroundColor3       = Color3.fromRGB(0,220,255)
FingerDot.BackgroundTransparency = 0.2
FingerDot.BorderSizePixel        = 0
FingerDot.Visible                = false
FingerDot.ZIndex                 = 10
FingerDot.Parent                 = ScreenGui
Instance.new("UICorner", FingerDot).CornerRadius = UDim.new(1,0)

local function screenToWorldPosition(screenPos)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local unitRay = cam:ScreenPointToRay(screenPos.X, screenPos.Y)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = { Folder, LocalPlayer.Character }
    local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, raycastParams)
    if result then
        -- keep Y from result but allow float offset so center sits above ground
        return Vector3.new(result.Position.X, result.Position.Y + 5, result.Position.Z)
    else
        -- no hit — project onto a horizontal plane at current center Y
        local planeY  = staticCenterPosition.Y
        local t       = (planeY - unitRay.Origin.Y) / unitRay.Direction.Y
        if t > 0 then
            return unitRay.Origin + unitRay.Direction * t
        end
    end
    return nil
end

local function applyFingerDragPosition(screenPos)
    local worldPos = screenToWorldPosition(screenPos)
    if worldPos then
        staticCenterPosition = worldPos
        Part.Position        = staticCenterPosition
        FingerDot.Position   = UDim2.new(0, screenPos.X, 0, screenPos.Y)
        FingerDot.Visible    = true
    end
end

