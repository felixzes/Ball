local joystickActive  = false
local joystickTouchId = nil
local joystickOrigin  = Vector2.new()
local joystickDelta   = Vector2.new()
local JOYSTICK_RADIUS   = 50
local SPHERE_MOVE_SPEED = 0.6

local function applyJoystickDelta(dt)
    if not joystickActive then return end
    local cam     = Workspace.CurrentCamera
    local camCF   = cam and cam.CFrame or CFrame.new()
    local forward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
    local right   = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
    local move    = (right * joystickDelta.X + forward * (-joystickDelta.Y)) * SPHERE_MOVE_SPEED * dt
    staticCenterPosition = staticCenterPosition + move
    Part.Position = staticCenterPosition
end

local function clampKnob(delta, maxR)
    local mag = delta.Magnitude
    return mag > maxR and (delta / mag * maxR) or delta
end

local function updateKnob(screenDelta)
    local clamped = clampKnob(screenDelta, JOYSTICK_RADIUS)
    joystickDelta = clamped
