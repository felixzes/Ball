local flyEnabled  = false
local flyBodyVel  = nil
local flyBodyGyro = nil
local leftWing    = nil
local rightWing   = nil
local wingConn    = nil

local WING_COLOR = Color3.fromRGB(120,60,220)
local WING_TRAIL = Color3.fromRGB(180,120,255)

local function buildWing(isLeft)
    local weld = Instance.new("Weld")
    local wing = Instance.new("Part")
    wing.Name         = isLeft and "LeftWing" or "RightWing"
    wing.Size         = Vector3.new(0.2,2.5,4.5)
    wing.Anchored     = false
    wing.CanCollide   = false
    wing.CastShadow   = false
    wing.Material     = Enum.Material.Neon
    wing.Color        = WING_COLOR
    wing.Transparency = 0.15
    wing.Parent       = character

    local tip = Instance.new("Part")
    tip.Name         = isLeft and "LeftWingTip" or "RightWingTip"
    tip.Size         = Vector3.new(0.1,1.0,2.0)
    tip.Anchored     = false
    tip.CanCollide   = false
    tip.CastShadow   = false
    tip.Material     = Enum.Material.Neon
    tip.Color        = WING_TRAIL
    tip.Transparency = 0.25
    tip.Parent       = character

    local tipWeld  = Instance.new("Weld")
    tipWeld.Part0  = wing; tipWeld.Part1 = tip
    tipWeld.C0     = isLeft
        and CFrame.new(0,-1.2,-2.2) * CFrame.Angles(0,0,math.rad(-18))
        or  CFrame.new(0,-1.2, 2.2) * CFrame.Angles(0,0,math.rad(18))
    tipWeld.Parent = wing

    local a0 = Instance.new("Attachment", wing); local a1 = Instance.new("Attachment", wing)
    a0.Position = Vector3.new(0,0, isLeft and -2 or  2)
    a1.Position = Vector3.new(0,0, isLeft and  2 or -2)

    local trail = Instance.new("Trail")
    trail.Attachment0  = a0; trail.Attachment1 = a1
    trail.Color        = ColorSequence.new({
        ColorSequenceKeypoint.new(0, WING_TRAIL),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(60,0,120))
    })
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1.0)
    })
    trail.Lifetime = 0.25; trail.MinLength = 0; trail.FaceCamera = true; trail.Parent = wing

    weld.Part0  = humanoidRootPart; weld.Part1 = wing
    weld.C0     = CFrame.new((isLeft and -1 or 1) * 1.2, 0.5, 0.3)
    weld.Parent = wing
    return wing, weld
end

local function destroyWings()
    if leftWing  and leftWing.Parent  then leftWing:Destroy()  end
    if rightWing and rightWing.Parent then rightWing:Destroy() end
    leftWing = nil; rightWing = nil
    if wingConn then wingConn:Disconnect(); wingConn = nil end
end

local function spawnWings()
    destroyWings()
    leftWing  = buildWing(true)
    rightWing = buildWing(false)
    local flapT = 0; local flapSpeed = 3.5; local flapAmp = math.rad(42)
    wingConn = RunService.Heartbeat:Connect(function(dt)
        flapT = flapT + dt * flapSpeed
        local sf        = 1 + (flySpeed / 200)
        local flapAngle = math.sin(flapT * sf) * flapAmp
        local tiltAngle = math.sin(flapT * sf + math.pi * 0.5) * math.rad(12)
        local shimmer   = (math.sin(flapT * 2) + 1) / 2
        local wc = Color3.new(0.47 + shimmer*0.20, 0.24 + shimmer*0.12, 0.86 - shimmer*0.15)
        for _, wing in ipairs({ leftWing, rightWing }) do
            if wing and wing.Parent then
                local weld = wing:FindFirstChildWhichIsA("Weld")
                if weld then
                    local side = (wing.Name == "LeftWing") and -1 or 1
                    weld.C0 = CFrame.new(side*1.2, 0.5, 0.3) * CFrame.Angles(tiltAngle, 0, side*flapAngle)
                end
                wing.Color = wc
            end
        end
        for _, tipName in ipairs({ "LeftWingTip", "RightWingTip" }) do
            local tip = character:FindFirstChild(tipName)
            if tip then tip.Color = Color3.new(0.70+shimmer*0.10, 0.47+shimmer*0.08, 1.00) end
        end
    end)
end

local function enableFly()
    flyEnabled = true
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,  false)
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    flyBodyVel            = Instance.new("BodyVelocity")
    flyBodyVel.Velocity   = Vector3.new(0,0,0)
    flyBodyVel.MaxForce   = Vector3.new(1e6,1e6,1e6)
    flyBodyVel.P          = 1e4
    flyBodyVel.Parent     = humanoidRootPart
    flyBodyGyro           = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(1e6,1e6,1e6)
    flyBodyGyro.P         = 1e4
    flyBodyGyro.D         = 500
    flyBodyGyro.CFrame    = humanoidRootPart.CFrame
    flyBodyGyro.Parent    = humanoidRootPart
    spawnWings(); playSound("12221967")
end

local function disableFly()
    flyEnabled = false
    if flyBodyVel  then flyBodyVel:Destroy();  flyBodyVel  = nil end
    if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,  true)
    humanoid:ChangeState(Enum.HumanoidStateType.GravityScale)
    destroyWings(); playSound("12221967")
end

RunService.Heartbeat:Connect(function(dt)
    if not flyEnabled or not flyBodyVel or not flyBodyGyro then return end
    local cam   = Workspace.CurrentCamera
    local camCF = cam and cam.CFrame or CFrame.new()
    local moveVec = Vector3.new(0,0,0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up)    then moveVec = moveVec + camCF.LookVector  end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)  then moveVec = moveVec - camCF.LookVector  end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left)  then moveVec = moveVec - camCF.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then moveVec = moveVec + camCF.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.E) then moveVec = moveVec + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveVec = moveVec - Vector3.new(0,1,0) end
    if moveVec.Magnitude > 0 then
        flyBodyVel.Velocity = moveVec.Unit * flySpeed
    else
        flyBodyVel.Velocity = Vector3.new(flyBodyVel.Velocity.X*0.85, 0, flyBodyVel.Velocity.Z*0.85)
    end
    local lookFlat = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
    if lookFlat.Magnitude > 0.01 then
        flyBodyGyro.CFrame = CFrame.lookAt(Vector3.new(0,0,0), lookFlat)
    end
end)

