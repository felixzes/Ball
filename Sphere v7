-- ─── Sword Config ────────────────────────────────
local SWORD_TOTAL_HEIGHT = 120
local SWORD_BLADE_WIDTH  = 14
local SWORD_GRIP_WIDTH   = 3
local SWORD_POMMEL_SIZE  = 6
local SWORD_GUARD_WIDTH  = 22
local SWORD_GUARD_DEPTH  = 4
local swordYaw           = 0
local swordPitch         = 0

local function getSwordPosition(i, count, center)
    local t    = (i - 1) / math.max(count - 1, 1)
    local seed = i * 1.61803398875
    local jA   = (seed % 1) * 2 * math.pi
    local jB   = ((seed * 2.41421) % 1) * 2 * math.pi
    local x, y, z

    if t < 0.04 then
        local lt    = t / 0.04
        local phi   = lt * math.pi
        local theta = jA * 5
        local r     = SWORD_POMMEL_SIZE * math.sin(phi)
        x = r * math.cos(theta)
        z = r * math.sin(theta)
        y = -SWORD_TOTAL_HEIGHT * 0.5 + lt * SWORD_POMMEL_SIZE * 2
    elseif t < 0.18 then
        local lt    = (t - 0.04) / 0.14
        local theta = jA * math.pi * 2
        local r     = SWORD_GRIP_WIDTH * ((jB % 1) ^ 0.5)
        x = r * math.cos(theta)
        z = r * math.sin(theta)
        y = -SWORD_TOTAL_HEIGHT * 0.5 + SWORD_POMMEL_SIZE * 2 + lt * (SWORD_TOTAL_HEIGHT * 0.14)
    elseif t < 0.24 then
        local side = (i % 2 == 0) and 1 or -1
        local armT = (jA % 1)
        x = side * armT * SWORD_GUARD_WIDTH
        z = ((jB % 1) - 0.5) * SWORD_GUARD_DEPTH
        y = -SWORD_TOTAL_HEIGHT * 0.5 + SWORD_TOTAL_HEIGHT * 0.21
    else
        local lt    = (t - 0.24) / 0.76
        local taper = 1 - lt
        local halfW = SWORD_BLADE_WIDTH * 0.5 * taper
        local halfD = math.max(0.4, 1.2 * taper)
        local r     = (jA % 1) ^ 0.5
        local theta = jB
        x = r * halfW * math.cos(theta)
        z = r * halfD * math.sin(theta)
        y = -SWORD_TOTAL_HEIGHT * 0.5 + SWORD_TOTAL_HEIGHT * 0.24
            + lt * (SWORD_TOTAL_HEIGHT * 0.76)
    end

    local cosY = math.cos(swordYaw);   local sinY = math.sin(swordYaw)
    local cosP = math.cos(swordPitch); local sinP = math.sin(swordPitch)
    local rx  = cosY * x - sinY * z
    local rz  = sinY * x + cosY * z
    local ry2 = cosP * y - sinP * rz
    local rz2 = sinP * y + cosP * rz

    return Vector3.new(center.X + rx, center.Y + ry2, center.Z + rz2)
end

-- ─── Target position resolver ────────────────────
local function getTargetPosition(i, count, t, center)
    local shape = SHAPES[shapeIndex]
    if shape == "Sphere" then
        local phi   = math.acos(1 - 2 * i / math.max(count, 1))
        local theta = (math.pi * (1 + math.sqrt(5)) * i) + t
        return Vector3.new(
            center.X + radius * math.sin(phi) * math.cos(theta),
            center.Y + radius * math.cos(phi),
            center.Z + radius * math.sin(phi) * math.sin(theta)
        )
    elseif shape == "Ring" then
        local angle = (2 * math.pi * i / math.max(count, 1)) + t
        return Vector3.new(
            center.X + radius * math.cos(angle),
            center.Y,
            center.Z + radius * math.sin(angle)
        )
    elseif shape == "Grid" then
        local n    = math.ceil(count ^ (1/3))
        local nx   = (i - 1) % n
        local ny   = math.floor((i - 1) / n) % n
        local nz   = math.floor((i - 1) / (n * n)) % n
        local half = (n - 1) / 2
        return Vector3.new(
            center.X + (nx - half) * gridSpacing,
            center.Y + (ny - half) * gridSpacing,
            center.Z + (nz - half) * gridSpacing
        )
    elseif shape == "Helix" then
        local frac  = i / math.max(count, 1)
        local angle = frac * helixTurns * 2 * math.pi + t
        return Vector3.new(
            center.X + radius * math.cos(angle),
            center.Y - helixHeight / 2 + frac * helixHeight,
            center.Z + radius * math.sin(angle)
        )
    elseif shape == "Sword" then
        return getSwordPosition(i, count, center)
    end
    return center
end

