-- ─── Part Pool ───────────────────────────────────
local sphereEnabled      = false
local STEAL_ENABLED      = false
local partAngles         = {}
local attractionStrength = 999999
local STEAL_STRENGTH     = 999999

local function ForcePart(v)
    if v:IsA("BasePart")
        and not v.Parent:FindFirstChild("Humanoid")
        and not v.Parent:FindFirstChild("Head")
        and v.Name ~= "Handle" then
        for _, x in next, v:GetChildren() do
            if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
               or x:IsA("BodyPosition") or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
               or x:IsA("RocketPropulsion") then x:Destroy() end
        end
        if v:FindFirstChild("Attachment")    then v:FindFirstChild("Attachment"):Destroy()    end
        if v:FindFirstChild("AlignPosition") then v:FindFirstChild("AlignPosition"):Destroy() end
        if v:FindFirstChild("Torque")        then v:FindFirstChild("Torque"):Destroy()        end
        v.CanCollide = false
        local Torque        = Instance.new("Torque", v)
        Torque.Torque       = Vector3.new(100000,100000,100000)
        local Attachment2   = Instance.new("Attachment", v)
        Torque.Attachment0  = Attachment2
        local AlignPosition = Instance.new("AlignPosition", v)
        AlignPosition.MaxForce       = math.huge
        AlignPosition.MaxVelocity    = math.huge
        AlignPosition.Responsiveness = 1000
        AlignPosition.Attachment0    = Attachment2
        AlignPosition.Attachment1    = Attachment1
    end
end

local function isEligiblePart(part)
    if not part:IsA("BasePart") then return false end
    if part.Anchored then return false end
    if not part:IsDescendantOf(Workspace) then return false end
    if part:IsDescendantOf(Folder) then return false end
    if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then return false end
    local ancestor = part.Parent
    while ancestor and ancestor ~= Workspace do
        if ancestor:FindFirstChild("Humanoid") or ancestor:FindFirstChild("Head") then return false end
        ancestor = ancestor.Parent
    end
    return true
end

local function addPart(part)
    if isEligiblePart(part) and not table.find(parts, part) then
        if getgenv().Network then getgenv().Network.RetainPart(part) end
        ForcePart(part)
        table.insert(parts, part)
        local idx = #parts
        partAngles[part] = {
            phi   = math.acos(1 - 2 * idx / math.max(idx, 1)),
            theta = math.pi * (1 + math.sqrt(5)) * idx
        }
    end
end

local function removePart(part)
    local idx = table.find(parts, part)
    if idx then table.remove(parts, idx); partAngles[part] = nil end
    removePartFromRing(part)
end

for _, obj in ipairs(Workspace:GetDescendants()) do addPart(obj) end
Workspace.DescendantAdded:Connect(addPart)
Workspace.DescendantRemoving:Connect(removePart)

RunService.Stepped:Connect(function()
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") and not part.Anchored then addPart(part) end
    end
end)

-- ─── Shape Engine ────────────────────────────────
local t = 0
RunService.Heartbeat:Connect(function(dt)
    if not sphereEnabled then return end
    t = t + dt * rotationSpeed
    local center = staticCenterPosition
    local count  = #parts
    for i, part in ipairs(parts) do
        if part.Parent and not part.Anchored then
            local target = getTargetPosition(i, count, t, center)
            local dir    = target - part.Position
            if dir.Magnitude > 0 then
                part.Velocity = (dir / dir.Magnitude) * attractionStrength
            end
        end
    end
end)

