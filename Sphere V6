        if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        activeTouches[input] = true
        applyTouchMove(Vector2.new(input.Position.X, input.Position.Y))
    end)
    TouchOverlay.InputChanged:Connect(function(input)
        if not TOUCH_MOVE_ENABLED then return end
        if not activeTouches[input] then return end
        if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        applyTouchMove(Vector2.new(input.Position.X, input.Position.Y))
    end)
    TouchOverlay.InputEnded:Connect(function(input) activeTouches[input] = nil end)
end

