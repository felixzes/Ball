-- ─── TOUCH TO MOVE ───────────────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════
local TOUCH_MOVE_ENABLED = false
local TOUCH_EXCLUSION_R  = 14
local activeTouches      = {}

local function screenToWorld(screenPos)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local unitRay = cam:ScreenPointToRay(screenPos.X, screenPos.Y)
    local planeY  = humanoidRootPart and humanoidRootPart.Position.Y or staticCenterPosition.Y
    local origin  = unitRay.Origin
    local dir     = unitRay.Direction
    if math.abs(dir.Y) < 0.0001 then return origin + dir * 100 end
    local t2 = (planeY - origin.Y) / dir.Y
    if t2 < 0 then return origin + dir * 100 end
    return origin + dir * t2
end

local function applyTouchMove(screenPos)
    local worldPos = screenToWorld(screenPos)
    if not worldPos then return end
    local desired = Vector3.new(worldPos.X, staticCenterPosition.Y, worldPos.Z)
    if humanoidRootPart then
        local playerFlat = Vector3.new(humanoidRootPart.Position.X, staticCenterPosition.Y, humanoidRootPart.Position.Z)
        local diff = desired - playerFlat
        local dist = diff.Magnitude
        if dist < TOUCH_EXCLUSION_R then
            desired = dist < 0.01
                and playerFlat + Vector3.new(TOUCH_EXCLUSION_R, 0, 0)
                or  playerFlat + diff.Unit * TOUCH_EXCLUSION_R
        end
    end
    staticCenterPosition = desired
    Part.Position        = staticCenterPosition
end

