        local mapped = dir
        if dir == Vector3.new(-1,0,0) then
            mapped = -Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
        elseif dir == Vector3.new(1,0,0) then
            mapped =  Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
        elseif dir == Vector3.new(0,0,-1) then
            mapped =  Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
        elseif dir == Vector3.new(0,0,1) then
            mapped = -Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
