-- ─── Shape State ─────────────────────────────────────────────────────────────
local SHAPES        = { "Sphere", "Ring", "Grid", "Helix", "Sword", "Wall", "Tornado", "Comet" }
local shapeIndex    = 1
local radius        = 50
local rotationSpeed = 0.5
local gridSpacing   = 8
local helixTurns    = 3
local helixHeight   = 60

local function getTargetPosition(i, count, t, center)
    local shape = SHAPES[shapeIndex]
    count = math.max(count, 1)

    if shape == "Sphere" then
        local phi   = math.acos(1 - 2 * i / count)
        local theta = (math.pi * (1 + math.sqrt(5)) * i) + t
        return Vector3.new(
            center.X + radius * math.sin(phi) * math.cos(theta),
            center.Y + radius * math.cos(phi),
            center.Z + radius * math.sin(phi) * math.sin(theta)
        )

    elseif shape == "Ring" then
        local angle = (2 * math.pi * i / count) + t
        return Vector3.new(
            center.X + radius * math.cos(angle),
            center.Y,
            center.Z + radius * math.sin(angle)
        )

    elseif shape == "Grid" then
        local n    = math.ceil(count ^ (1/3))
        local nx   = (i - 1) % n
        local ny   = math.floor((i - 1) / n) % n
        local nz   = math.floor((i - 1) / (n * n)) % n
        local half = (n - 1) / 2
        return Vector3.new(
            center.X + (nx - half) * gridSpacing,
            center.Y + (ny - half) * gridSpacing,
            center.Z + (nz - half) * gridSpacing
        )

    elseif shape == "Helix" then
        local frac  = i / count
        local angle = frac * helixTurns * 2 * math.pi + t
        return Vector3.new(
            center.X + radius * math.cos(angle),
            center.Y - helixHeight / 2 + frac * helixHeight,
            center.Z + radius * math.sin(angle)
        )

    -- ── SWORD ──────────────────────────────────────────────────────────────────
    elseif shape == "Sword" then
        local cam     = Workspace.CurrentCamera
        local camCF   = cam and cam.CFrame or CFrame.new()
        local forward = camCF.LookVector
        local up      = camCF.UpVector
        local right   = camCF.RightVector

        local bladeLen  = math.clamp(count * 1.2, 40, 400)
        local guardW    = bladeLen * 0.22
        local gripLen   = bladeLen * 0.14
        local guardT    = math.max(3, math.floor(count * 0.06))
        local gripT     = math.max(3, math.floor(count * 0.08))
        local pommelT   = math.max(2, math.floor(count * 0.04))

        local bladeStart = center - forward * (bladeLen * 0.12)

        local pommelStart = count - pommelT + 1
        local gripStart   = pommelStart - gripT
        local guardStart  = gripStart - guardT

        if i >= pommelStart then
            local pi2   = i - pommelStart
            local angle = (2 * math.pi * pi2 / pommelT) + t * 0.4
            local pr    = 1.8
            return center
                - forward * (bladeLen * 0.13 + pr)
                + right   * math.cos(angle) * pr
                + up      * math.sin(angle) * pr

        elseif i >= gripStart then
            local gi    = i - gripStart
            local frac  = gi / math.max(gripT, 1)
            local taper = 0.9 - frac * 0.3
            local angle = (2 * math.pi * gi / math.max(gripT, 1)) * 0.4
            local gr    = taper * 1.2
            return center
                - forward * (bladeLen * 0.12 - frac * gripLen)
                + right   * math.cos(angle + t * 0.2) * gr
                + up      * math.sin(angle + t * 0.2) * gr

        elseif i >= guardStart then
            local gi   = i - guardStart
            local frac = (gi / math.max(guardT - 1, 1)) * 2 - 1
            local sway = math.sin(t * 0.5) * 0.4
            return center
                + forward * gripLen * 0.1
                + right   * frac * guardW
                + up      * sway

        else
            local frac  = i / math.max(guardStart - 1, 1)
            local bPos  = bladeStart + forward * (frac * bladeLen * 0.9)
            local w     = (1 - frac) * 0.6 + 0.05
            local col   = i % 3
            local edgeX = (col == 1) and -w or (col == 2) and w or 0
            local edgeY = (col == 0) and w * 0.15 or 0
            return bPos + right * edgeX + up * edgeY
        end

    -- ── WALL ───────────────────────────────────────────────────────────────────
    elseif shape == "Wall" then
        local cam     = Workspace.CurrentCamera
        local camCF   = cam and cam.CFrame or CFrame.new()
        local right   = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
        if right.Magnitude > 0.01 then right = right.Unit end

        local wallW   = math.clamp(count * 0.8, 30, 350)
        local wallH   = math.clamp(count * 0.5, 20, 200)
        local cols    = math.max(1, math.ceil(math.sqrt(count * (wallW / wallH))))
        local rows    = math.max(1, math.ceil(count / cols))
        local col     = (i - 1) % cols
        local row     = math.floor((i - 1) / cols)
        local xFrac   = cols > 1 and (col / (cols - 1)) or 0.5
        local yFrac   = rows > 1 and (row / (rows - 1)) or 0.5
        local xOff    = (xFrac - 0.5) * wallW
        local yOff    = (yFrac - 0.5) * wallH
        local wave    = math.sin(t * 1.2 + xFrac * math.pi * 2) * 3

        return center
            + right   * xOff
            + Vector3.new(0, yOff + wave, 0)

    -- ── TORNADO ────────────────────────────────────────────────────────────────
    elseif shape == "Tornado" then
        local frac    = i / count
        local angle   = frac * helixTurns * 4 * math.pi + t * 3
        local h       = (frac - 0.5) * helixHeight * 1.5
        local r       = radius * (0.08 + frac * 0.92)
        local wobble  = math.sin(t * 2 + frac * math.pi * 3) * r * 0.08
        return Vector3.new(
            center.X + (r + wobble) * math.cos(angle),
            center.Y + h,
            center.Z + (r + wobble) * math.sin(angle)
        )

    -- ── COMET ──────────────────────────────────────────────────────────────────
    elseif shape == "Comet" then
        local cam     = Workspace.CurrentCamera
        local camCF   = cam and cam.CFrame or CFrame.new()
        local forward = camCF.LookVector
        local up      = camCF.UpVector
        local right   = camCF.RightVector

        local headCount = math.max(1, math.floor(count * 0.18))
        local tailLen   = radius * 3.5

        if i <= headCount then
            -- nucleus: tight sphere cluster
            local phi   = math.acos(1 - 2 * i / headCount)
            local theta = (math.pi * (1 + math.sqrt(5)) * i) + t
            local r     = radius * 0.22
            return center
                + right   * r * math.sin(phi) * math.cos(theta)
                + up      * r * math.cos(phi)
                - forward * r * math.sin(phi) * math.sin(theta)
        else
            -- tail: stretches behind the forward direction, fans out
            local ti    = i - headCount
            local tc    = count - headCount
            local frac  = ti / math.max(tc, 1)
            local spread= frac * radius * 0.55
            local angle = (ti % 7) / 7 * 2 * math.pi + t * 0.3
            local drift = math.sin(t * 0.8 + frac * math.pi) * spread * 0.3
            return center
                - forward * (frac * tailLen)
                + right   * (math.cos(angle) * spread + drift)
                + up      * (math.sin(angle) * spread * 0.5)
        end
    end

    return center
end

