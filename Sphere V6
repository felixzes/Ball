-- ─── CUSTOM WALK ANIMATION ───────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════

local animConn = nil
local walkT    = 0

local ANIM = {
    CYCLE_SPEED      = 7.5,
    HEAD_PITCH       = math.rad(8),
    HEAD_BOB_AMP     = math.rad(2),
    HEAD_SWAY_AMP    = math.rad(1.2),
    NECK_PITCH       = math.rad(6),
    HIP_SWAY_AMP     = math.rad(4),
    TORSO_TWIST_AMP  = math.rad(3),
    TORSO_BOB_AMP    = math.rad(1.5),
    WAIST_PITCH      = math.rad(2),
    ARM_PITCH        = math.rad(92),
    ARM_ROLL_L       = math.rad(-38),
    ARM_ROLL_R       = math.rad( 38),
    ARM_CROSS_YAW    = math.rad(18),
    ARM_IDLE_FLOAT   = math.rad(1.5),
    LEG_SWING_AMP    = math.rad(30),
    KNEE_BEND_AMP    = math.rad(22),
    ANKLE_STRIKE_AMP = math.rad(14),
    HIP_HEIGHT_AMP   = 0.06,
}

local function detectRig(char)
    if char:FindFirstChild("UpperTorso") then return "R15" end
    if char:FindFirstChild("Torso")      then return "R6"  end
    return nil
end

local function getMotors(char)
    local rig = detectRig(char)
    if rig == "R15" then
        local UT = char:FindFirstChild("UpperTorso")
        local LT = char:FindFirstChild("LowerTorso")
        local H  = char:FindFirstChild("Head")
        if not (UT and LT) then return nil, nil end
        return rig, {
            waist     = UT:FindFirstChild("Waist"),
            neck      = H  and H:FindFirstChild("Neck")  or UT:FindFirstChild("Neck"),
            lShoulder = UT:FindFirstChild("LeftShoulder"),
            rShoulder = UT:FindFirstChild("RightShoulder"),
            lElbow    = char:FindFirstChild("LeftLowerArm")  and char:FindFirstChild("LeftLowerArm"):FindFirstChild("LeftElbow"),
            rElbow    = char:FindFirstChild("RightLowerArm") and char:FindFirstChild("RightLowerArm"):FindFirstChild("RightElbow"),
            lHip      = LT:FindFirstChild("LeftHip"),
            rHip      = LT:FindFirstChild("RightHip"),
            lKnee     = char:FindFirstChild("LeftLowerLeg")  and char:FindFirstChild("LeftLowerLeg"):FindFirstChild("LeftKnee"),
            rKnee     = char:FindFirstChild("RightLowerLeg") and char:FindFirstChild("RightLowerLeg"):FindFirstChild("RightKnee"),
            lAnkle    = char:FindFirstChild("LeftFoot")  and char:FindFirstChild("LeftFoot"):FindFirstChild("LeftAnkle"),
            rAnkle    = char:FindFirstChild("RightFoot") and char:FindFirstChild("RightFoot"):FindFirstChild("RightAnkle"),
        }
    elseif rig == "R6" then
        local torso = char:FindFirstChild("Torso")
        if not torso then return nil, nil end
        return rig, {
            neck      = torso:FindFirstChild("Neck"),
            lShoulder = torso:FindFirstChild("Left Shoulder"),
            rShoulder = torso:FindFirstChild("Right Shoulder"),
            lHip      = torso:FindFirstChild("Left Hip"),
            rHip      = torso:FindFirstChild("Right Hip"),
        }
    end
    return nil, nil
end

local defaultC0 = {}

local function cacheDefaults(motors)
    for k, m in pairs(motors) do
        if m and m:IsA("Motor6D") then
            defaultC0[k] = m.C0
        end
    end
end

local function safeSet(motor, cf)
    if motor and motor.Parent and motor:IsA("Motor6D") then
        motor.C0 = cf
    end
end

local function startWalkAnim(char, hum)
    if animConn then animConn:Disconnect(); animConn = nil end
    defaultC0 = {}
    local rig, motors = getMotors(char)
    if not rig or not motors then return end
    cacheDefaults(motors)

    animConn = RunService.Heartbeat:Connect(function(dt)
        walkT = walkT + dt
        local rig2, m = getMotors(char)
        if not rig2 or not m then return end

        local speed  = hum.MoveDirection.Magnitude
        local moving = speed > 0.1

        local legAmp  = moving and ANIM.LEG_SWING_AMP    or 0
        local kneeAmp = moving and ANIM.KNEE_BEND_AMP    or 0
        local ankAmp  = moving and ANIM.ANKLE_STRIKE_AMP or 0

        local c  = walkT * ANIM.CYCLE_SPEED
        local s  = math.sin(c)
        local s2 = math.sin(c * 2)
        local c1 = math.cos(c)

        local lThigh = s  * legAmp
        local rThigh = -s * legAmp
        local lKnee  = math.max(0,  c1) * kneeAmp
        local rKnee  = math.max(0, -c1) * kneeAmp
        local lAnkle = -math.sin(c - 0.4) * ankAmp
        local rAnkle =  math.sin(c - 0.4) * ankAmp

        local hipSway    = -s  * ANIM.HIP_SWAY_AMP
        local torsoTwist =  s  * ANIM.TORSO_TWIST_AMP
        local bob        = s2 * ANIM.TORSO_BOB_AMP
        local breathe    = math.sin(walkT * 1.8) * ANIM.ARM_IDLE_FLOAT

        if rig2 == "R15" then
            local dc = defaultC0["waist"] or CFrame.new()
            safeSet(m.waist, dc * CFrame.Angles(ANIM.WAIST_PITCH + bob, torsoTwist, hipSway))
            local dn = defaultC0["neck"] or CFrame.new()
            safeSet(m.neck, dn * CFrame.Angles(ANIM.NECK_PITCH + s * ANIM.HEAD_BOB_AMP, s * ANIM.HEAD_SWAY_AMP, 0))
            local dls = defaultC0["lShoulder"] or CFrame.new(-0.5,0,0)
            safeSet(m.lShoulder, dls * CFrame.Angles(ANIM.ARM_PITCH, -ANIM.ARM_CROSS_YAW, ANIM.ARM_ROLL_L + breathe))
            local drs = defaultC0["rShoulder"] or CFrame.new(0.5,0,0)
            safeSet(m.rShoulder, drs * CFrame.Angles(ANIM.ARM_PITCH, ANIM.ARM_CROSS_YAW, ANIM.ARM_ROLL_R - breathe))
            if m.lElbow then
                safeSet(m.lElbow, (defaultC0["lElbow"] or CFrame.new()) * CFrame.Angles(0, 0, math.rad(-55)))
            end
            if m.rElbow then
                safeSet(m.rElbow, (defaultC0["rElbow"] or CFrame.new()) * CFrame.Angles(0, 0, math.rad(55)))
            end
            local dlh = defaultC0["lHip"] or CFrame.new()
            safeSet(m.lHip, dlh * CFrame.Angles(lThigh, 0, hipSway * 0.5))
            if m.lKnee then safeSet(m.lKnee, (defaultC0["lKnee"] or CFrame.new()) * CFrame.Angles(-lKnee, 0, 0)) end
            if m.lAnkle then safeSet(m.lAnkle, (defaultC0["lAnkle"] or CFrame.new()) * CFrame.Angles(lAnkle, 0, 0)) end
            local drh = defaultC0["rHip"] or CFrame.new()
            safeSet(m.rHip, drh * CFrame.Angles(rThigh, 0, hipSway * 0.5))
            if m.rKnee then safeSet(m.rKnee, (defaultC0["rKnee"] or CFrame.new()) * CFrame.Angles(-rKnee, 0, 0)) end
            if m.rAnkle then safeSet(m.rAnkle, (defaultC0["rAnkle"] or CFrame.new()) * CFrame.Angles(rAnkle, 0, 0)) end

        elseif rig2 == "R6" then
            safeSet(m.neck,
                CFrame.new(0, 1, 0) * CFrame.Angles(-math.pi/2 + ANIM.HEAD_PITCH + s * ANIM.HEAD_BOB_AMP, s * ANIM.HEAD_SWAY_AMP, math.pi))
            safeSet(m.lShoulder,
                CFrame.new(-1, 0.5, 0) * CFrame.Angles(ANIM.ARM_PITCH, -ANIM.ARM_CROSS_YAW, -math.pi/2 + ANIM.ARM_ROLL_L + breathe))
            safeSet(m.rShoulder,
                CFrame.new(1, 0.5, 0) * CFrame.Angles(ANIM.ARM_PITCH, ANIM.ARM_CROSS_YAW, math.pi/2 + ANIM.ARM_ROLL_R - breathe))
            safeSet(m.lHip, CFrame.new(-1, -1, 0) * CFrame.Angles(lThigh, 0, -math.pi/2))
            safeSet(m.rHip, CFrame.new(1, -1, 0)  * CFrame.Angles(rThigh, 0,  math.pi/2))
        end
    end)
end

local function stopWalkAnim()
    if animConn then animConn:Disconnect(); animConn = nil end
    local rig, motors = getMotors(character)
    if motors then
        for k, m in pairs(motors) do
            if m and m:IsA("Motor6D") and defaultC0[k] then m.C0 = defaultC0[k] end
        end
    end
end

startWalkAnim(character, humanoid)

