-- ─── OUTER PULL RING ─────────────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════
local RING_COUNT      = 12
local RING_OFFSET     = 10
local RING_PULL_FORCE = math.huge
local RING_PULL_RESP  = 2000
local ringEnabled     = false
local ringAngle       = 0
local ringNodes       = {}
local ringPool        = {}
local ringParts       = {}
local parts           = {}
local partAngles      = {}

local function removePartFromRing(part)
    local idx = table.find(ringParts, part)
    if idx then table.remove(ringParts, idx); ringPool[part] = nil end
end

local function buildRingNodes()
    for i = 1, RING_COUNT do
        local anchor        = Instance.new("Part", Folder)
        anchor.Anchored     = true
        anchor.CanCollide   = false
        anchor.Transparency = 1
        anchor.Size         = Vector3.new(1, 1, 1)
        anchor.Position     = staticCenterPosition
        local att           = Instance.new("Attachment", anchor)
        ringNodes[i]        = { anchor = anchor, att = att }
    end
end

local function destroyRingNodes()
    for _, node in ipairs(ringNodes) do
        if node.anchor and node.anchor.Parent then node.anchor:Destroy() end
    end
    ringNodes = {}; ringPool = {}; ringParts = {}
end

local function updateRingNodePositions(center, r)
    local ringRadius = r + RING_OFFSET
    for i, node in ipairs(ringNodes) do
        local angle = ringAngle + (2 * math.pi * (i - 1) / RING_COUNT)
        node.anchor.Position = Vector3.new(
            center.X + ringRadius * math.cos(angle),
            center.Y,
            center.Z + ringRadius * math.sin(angle)
        )
    end
end

local function forcePartToRingNode(part, nodeIndex)
    local node = ringNodes[nodeIndex]
    if not node then return end
    for _, x in next, part:GetChildren() do
        if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
        or x:IsA("BodyPosition") or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
        or x:IsA("RocketPropulsion") then x:Destroy() end
    end
    if part:FindFirstChild("RingAttachment")    then part:FindFirstChild("RingAttachment"):Destroy()    end
    if part:FindFirstChild("RingAlignPosition") then part:FindFirstChild("RingAlignPosition"):Destroy() end
    if part:FindFirstChild("RingTorque")        then part:FindFirstChild("RingTorque"):Destroy()        end
    part.CanCollide = false
    local partAtt      = Instance.new("Attachment", part); partAtt.Name = "RingAttachment"
    local torque       = Instance.new("Torque", part);     torque.Name  = "RingTorque"
    torque.Torque      = Vector3.new(100000, 100000, 100000)
    torque.Attachment0 = partAtt
    local ap           = Instance.new("AlignPosition", part); ap.Name = "RingAlignPosition"
    ap.MaxForce        = RING_PULL_FORCE
    ap.MaxVelocity     = math.huge
    ap.Responsiveness  = RING_PULL_RESP
    ap.Attachment0     = partAtt
    ap.Attachment1     = node.att
    ap.Parent          = part
end

local function isEligibleForRing(part)
    if not part:IsA("BasePart") then return false end
    if part.Anchored then return false end
    if not part:IsDescendantOf(Workspace) then return false end
    if part:IsDescendantOf(Folder) then return false end
    if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then return false end
    local ancestor = part.Parent
    while ancestor and ancestor ~= Workspace do
        if ancestor:FindFirstChild("Humanoid") or ancestor:FindFirstChild("Head") then return false end
        ancestor = ancestor.Parent
    end
    return true
end

local function addPartToRing(part)
    if not ringEnabled then return end
    if not isEligibleForRing(part) then return end
    if table.find(parts, part) then return end
    if table.find(ringParts, part) then return end
    if getgenv().Network then getgenv().Network.RetainPart(part) end
    table.insert(ringParts, part)
    local nodeIndex = ((#ringParts - 1) % RING_COUNT) + 1
    ringPool[part]  = nodeIndex
    forcePartToRingNode(part, nodeIndex)
end

local function enableRing()
    ringEnabled = true
    buildRingNodes()
    updateRingNodePositions(staticCenterPosition, radius)
    for _, obj in ipairs(Workspace:GetDescendants()) do addPartToRing(obj) end
end

local function disableRing()
    ringEnabled = false
    for _, part in ipairs(ringParts) do
        if part and part.Parent then
            if part:FindFirstChild("RingAttachment")    then part:FindFirstChild("RingAttachment"):Destroy()    end
            if part:FindFirstChild("RingAlignPosition") then part:FindFirstChild("RingAlignPosition"):Destroy() end
            if part:FindFirstChild("RingTorque")        then part:FindFirstChild("RingTorque"):Destroy()        end
        end
    end
    destroyRingNodes()
end

RunService.Heartbeat:Connect(function(dt)
    if not ringEnabled then return end
    ringAngle = ringAngle + dt * rotationSpeed
    updateRingNodePositions(staticCenterPosition, radius)
    for _, obj in ipairs(Workspace:GetDescendants()) do addPartToRing(obj) end
end)

Workspace.DescendantAdded:Connect(function(obj)
    if ringEnabled then addPartToRing(obj) end
end)
Workspace.DescendantRemoving:Connect(removePartFromRing)

