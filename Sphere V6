local shapeT = 0
RunService.Heartbeat:Connect(function(dt)
    if not sphereEnabled then return end
    shapeT = shapeT + dt * rotationSpeed
    local center = staticCenterPosition
    local count  = #parts
    for i, part in ipairs(parts) do
        if part.Parent and not part.Anchored then
            local target = getTargetPosition(i, count, shapeT, center)
            local dir    = target - part.Position
            local dist   = dir.Magnitude
            if dist > 0 then
                local speed = attractionStrength * math.max(1, dist * 0.1)
                part.Velocity = (dir / dist) * speed
            end
        end
    end
end)

