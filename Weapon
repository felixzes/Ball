-- ─── TOUCH TO MOVE ───────────────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════
local TOUCH_MOVE_ENABLED=false; local TOUCH_EXCLUSION_R=14; local activeTouches={}

local function screenToWorld(sp)
    local cam=Workspace.CurrentCamera; if not cam then return nil end
    local ray=cam:ScreenPointToRay(sp.X,sp.Y)
    local planeY=humanoidRootPart and humanoidRootPart.Position.Y or staticCenterPosition.Y
    local o,d=ray.Origin,ray.Direction
    if math.abs(d.Y)<0.0001 then return o+d*100 end
    local t=(planeY-o.Y)/d.Y; if t<0 then return o+d*100 end
    return o+d*t
end

local function applyTouchMove(sp)
    local wp=screenToWorld(sp); if not wp then return end
    local desired=Vector3.new(wp.X,staticCenterPosition.Y,wp.Z)
    if humanoidRootPart then
        local pf=Vector3.new(humanoidRootPart.Position.X,staticCenterPosition.Y,humanoidRootPart.Position.Z)
        local diff=desired-pf; local dist=diff.Magnitude
        if dist<TOUCH_EXCLUSION_R then
            desired=dist<0.01 and pf+Vector3.new(TOUCH_EXCLUSION_R,0,0) or pf+diff.Unit*TOUCH_EXCLUSION_R
        end
    end
    staticCenterPosition=desired; Part.Position=staticCenterPosition
end

local TouchOverlay=Instance.new("Frame")
TouchOverlay.Size=UDim2.new(1,0,1,0); TouchOverlay.BackgroundTransparency=1
TouchOverlay.BorderSizePixel=0; TouchOverlay.ZIndex=1; TouchOverlay.Visible=false

local function connectTouchOverlay(sg)
    TouchOverlay.Parent=sg
    TouchOverlay.InputBegan:Connect(function(i)
        if not TOUCH_MOVE_ENABLED then return end
        if i.UserInputType~=Enum.UserInputType.Touch and i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
        activeTouches[i]=true; applyTouchMove(Vector2.new(i.Position.X,i.Position.Y))
    end)
    TouchOverlay.InputChanged:Connect(function(i)
        if not TOUCH_MOVE_ENABLED or not activeTouches[i] then return end
        if i.UserInputType~=Enum.UserInputType.Touch and i.UserInputType~=Enum.UserInputType.MouseMovement then return end
        applyTouchMove(Vector2.new(i.Position.X,i.Position.Y))
    end)
    TouchOverlay.InputEnded:Connect(function(i) activeTouches[i]=nil end)
end

RunService.Heartbeat:Connect(function()
    if not TOUCH_MOVE_ENABLED or not humanoidRootPart then return end
    local pf=Vector3.new(humanoidRootPart.Position.X,staticCenterPosition.Y,humanoidRootPart.Position.Z)
    local diff=staticCenterPosition-pf; local dist=diff.Magnitude
    if dist<TOUCH_EXCLUSION_R then
        staticCenterPosition=dist<0.01 and pf+Vector3.new(TOUCH_EXCLUSION_R,0,0) or pf+diff.Unit*TOUCH_EXCLUSION_R
        Part.Position=staticCenterPosition
    end
end)

