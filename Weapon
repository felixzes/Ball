local RING_COUNT  = 12; local RING_OFFSET = 10
local ringEnabled = false; local ringAngle = 0
local ringNodes   = {}; local ringPool = {}; local ringParts = {}
local parts       = {}; local partAngles = {}

local function removePartFromRing(part)
    local idx = table.find(ringParts, part)
    if idx then table.remove(ringParts, idx); ringPool[part] = nil end
end

local function buildRingNodes()
    for i = 1, RING_COUNT do
        local a=Instance.new("Part",Folder); a.Anchored=true; a.CanCollide=false
        a.Transparency=1; a.Size=Vector3.new(1,1,1); a.Position=staticCenterPosition
        local att=Instance.new("Attachment",a); ringNodes[i]={anchor=a,att=att}
    end
end

local function destroyRingNodes()
    for _,n in ipairs(ringNodes) do if n.anchor and n.anchor.Parent then n.anchor:Destroy() end end
    ringNodes={}; ringPool={}; ringParts={}
end

local function updateRingNodes(center, r)
    local rr = r + RING_OFFSET
    for i, n in ipairs(ringNodes) do
        local angle = ringAngle + (2*math.pi*(i-1)/RING_COUNT)
        n.anchor.Position = Vector3.new(center.X+rr*math.cos(angle), center.Y, center.Z+rr*math.sin(angle))
    end
end

local function forcePartToRingNode(part, ni)
    local node = ringNodes[ni]; if not node then return end
    for _,x in next,part:GetChildren() do
        if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
        or x:IsA("BodyPosition") or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
        or x:IsA("RocketPropulsion") then x:Destroy() end
    end
    for _,n in ipairs({"RingAttachment","RingAlignPosition","RingTorque"}) do
        local c=part:FindFirstChild(n); if c then c:Destroy() end
    end
    part.CanCollide=false
    local pAtt=Instance.new("Attachment",part); pAtt.Name="RingAttachment"
    local torque=Instance.new("Torque",part); torque.Name="RingTorque"
    torque.Torque=Vector3.new(1e9,1e9,1e9); torque.Attachment0=pAtt
    local ap=Instance.new("AlignPosition",part); ap.Name="RingAlignPosition"
    ap.MaxForce=MAX_FORCE; ap.MaxVelocity=MAX_VELOCITY; ap.Responsiveness=MAX_RESPONSE
    ap.Attachment0=pAtt; ap.Attachment1=node.att; ap.Parent=part
end

local function isEligibleForRing(part)
    if not part:IsA("BasePart") then return false end
    if part.Anchored then return false end
    if not part:IsDescendantOf(Workspace) then return false end
    if part:IsDescendantOf(Folder) then return false end
    if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then return false end
    local a=part.Parent
    while a and a~=Workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
        a=a.Parent
    end
    return true
end

local function addPartToRing(part)
    if not ringEnabled then return end
    if not isEligibleForRing(part) then return end
    if table.find(parts,part) or table.find(ringParts,part) then return end
    Network.RetainPart(part)
    table.insert(ringParts,part)
    local ni=((#ringParts-1)%RING_COUNT)+1
    ringPool[part]=ni; forcePartToRingNode(part,ni)
end

local function enableRing()
    ringEnabled=true; buildRingNodes()
    updateRingNodes(staticCenterPosition,radius)
    for _,o in ipairs(Workspace:GetDescendants()) do addPartToRing(o) end
end

local function disableRing()
    ringEnabled=false
    for _,p in ipairs(ringParts) do
        if p and p.Parent then
            for _,n in ipairs({"RingAttachment","RingAlignPosition","RingTorque"}) do
                local c=p:FindFirstChild(n); if c then c:Destroy() end
            end
        end
    end
    destroyRingNodes()
end

RunService.Heartbeat:Connect(function(dt)
    if not ringEnabled then return end
    ringAngle=ringAngle+dt*rotSpeed
    updateRingNodes(staticCenterPosition,radius)
    for _,o in ipairs(Workspace:GetDescendants()) do addPartToRing(o) end
end)
Workspace.DescendantAdded:Connect(function(o) if ringEnabled then addPartToRing(o) end end)
Workspace.DescendantRemoving:Connect(removePartFromRing)

