end

RunService.Heartbeat:Connect(function()
    if not flyEnabled or not flyBodyVel or not flyBodyGyro then return end
    local cam=Workspace.CurrentCamera; local cf=cam and cam.CFrame or CFrame.new()
    local mv=Vector3.new(0,0,0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up)    then mv=mv+cf.LookVector  end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)  then mv=mv-cf.LookVector  end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left)  then mv=mv-cf.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then mv=mv+cf.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.E) then mv=mv+Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) then mv=mv-Vector3.new(0,1,0) end
    flyBodyVel.Velocity=mv.Magnitude>0 and mv.Unit*flySpeed or Vector3.new(flyBodyVel.Velocity.X*0.85,0,flyBodyVel.Velocity.Z*0.85)
    local lf=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)
