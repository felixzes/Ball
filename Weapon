local WING_COLOR=Color3.fromRGB(120,60,220); local WING_TRAIL=Color3.fromRGB(180,120,255)

local function buildWing(isLeft)
    local weld=Instance.new("Weld")
    local wing=Instance.new("Part"); wing.Name=isLeft and "LeftWing" or "RightWing"
    wing.Size=Vector3.new(0.2,2.5,4.5); wing.Anchored=false; wing.CanCollide=false
    wing.CastShadow=false; wing.Material=Enum.Material.Neon; wing.Color=WING_COLOR
    wing.Transparency=0.15; wing.Parent=character
    local tip=Instance.new("Part"); tip.Name=isLeft and "LeftWingTip" or "RightWingTip"
    tip.Size=Vector3.new(0.1,1.0,2.0); tip.Anchored=false; tip.CanCollide=false
    tip.CastShadow=false; tip.Material=Enum.Material.Neon; tip.Color=WING_TRAIL
    tip.Transparency=0.25; tip.Parent=character
    local tw=Instance.new("Weld"); tw.Part0=wing; tw.Part1=tip
    tw.C0=isLeft and CFrame.new(0,-1.2,-2.2)*CFrame.Angles(0,0,math.rad(-18)) or CFrame.new(0,-1.2,2.2)*CFrame.Angles(0,0,math.rad(18))
    tw.Parent=wing
    local a0=Instance.new("Attachment",wing); local a1=Instance.new("Attachment",wing)
    a0.Position=Vector3.new(0,0,isLeft and -2 or 2); a1.Position=Vector3.new(0,0,isLeft and 2 or -2)
    local tr=Instance.new("Trail"); tr.Attachment0=a0; tr.Attachment1=a1
    tr.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,WING_TRAIL),ColorSequenceKeypoint.new(1,Color3.fromRGB(60,0,120))})
    tr.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.1),NumberSequenceKeypoint.new(1,1.0)})
    tr.Lifetime=0.25; tr.MinLength=0; tr.FaceCamera=true; tr.Parent=wing
    weld.Part0=humanoidRootPart; weld.Part1=wing
    weld.C0=CFrame.new((isLeft and -1 or 1)*1.2,0.5,0.3); weld.Parent=wing
    return wing,weld
end

local function destroyWings()
    if leftWing  and leftWing.Parent  then leftWing:Destroy()  end
    if rightWing and rightWing.Parent then rightWing:Destroy() end
    leftWing=nil; rightWing=nil
    if wingConn then wingConn:Disconnect(); wingConn=nil end
end

local function spawnWings()
    destroyWings(); leftWing=buildWing(true); rightWing=buildWing(false)
    local flapT=0; local flapSpd=3.5; local flapAmp=math.rad(42)
    wingConn=RunService.Heartbeat:Connect(function(dt)
        flapT=flapT+dt*flapSpd
        local sf=1+(flySpeed/200); local fa=math.sin(flapT*sf)*flapAmp
        local ta=math.sin(flapT*sf+math.pi*0.5)*math.rad(12)
        local sh=(math.sin(flapT*2)+1)/2
        local wc=Color3.new(0.47+sh*0.20,0.24+sh*0.12,0.86-sh*0.15)
        for _,w in ipairs({leftWing,rightWing}) do
            if w and w.Parent then
                local wi=w:FindFirstChildWhichIsA("Weld")
                if wi then local side=(w.Name=="LeftWing") and -1 or 1; wi.C0=CFrame.new(side*1.2,0.5,0.3)*CFrame.Angles(ta,0,side*fa) end
                w.Color=wc
            end
        end
        for _,tn in ipairs({"LeftWingTip","RightWingTip"}) do
            local tip=character:FindFirstChild(tn)
            if tip then tip.Color=Color3.new(0.70+sh*0.10,0.47+sh*0.08,1.00) end
        end
    end)
end

local function enableFly()
    flyEnabled=true
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall,false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
    flyBodyVel=Instance.new("BodyVelocity"); flyBodyVel.Velocity=Vector3.new(0,0,0)
    flyBodyVel.MaxForce=Vector3.new(1e6,1e6,1e6); flyBodyVel.P=1e4; flyBodyVel.Parent=humanoidRootPart
    flyBodyGyro=Instance.new("BodyGyro"); flyBodyGyro.MaxTorque=Vector3.new(1e6,1e6,1e6)
    flyBodyGyro.P=1e4; flyBodyGyro.D=500; flyBodyGyro.CFrame=humanoidRootPart.CFrame; flyBodyGyro.Parent=humanoidRootPart
    spawnWings(); playSound("12221967")
end

local function disableFly()
    flyEnabled=false
    if flyBodyVel  then flyBodyVel:Destroy();  flyBodyVel=nil  end
    if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro=nil end
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall,true)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,true)
