local function applyJsDelta(dt)
    if not jsActive then return end
    local cam=Workspace.CurrentCamera; local cf=cam and cam.CFrame or CFrame.new()
    local fwd=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z).Unit
