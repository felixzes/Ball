-- ─── Shape State ─────────────────────────────────────────────────────────────
local SHAPES      = { "Sphere", "Ring", "Grid", "Helix" }
local shapeIndex  = 1
local radius      = 50
local rotSpeed    = 0.5
local gridSpacing = 8
local helixTurns  = 3
local helixHeight = 60

local function getTargetPosition(i, count, t, center)
    local shape = SHAPES[shapeIndex]
    if shape == "Sphere" then
        local phi   = math.acos(1 - 2 * i / math.max(count, 1))
        local theta = (math.pi * (1 + math.sqrt(5)) * i) + t
        return Vector3.new(
            center.X + radius * math.sin(phi) * math.cos(theta),
            center.Y + radius * math.cos(phi),
            center.Z + radius * math.sin(phi) * math.sin(theta)
        )
    elseif shape == "Ring" then
        local angle = (2 * math.pi * i / math.max(count, 1)) + t
        return Vector3.new(center.X + radius * math.cos(angle), center.Y, center.Z + radius * math.sin(angle))
    elseif shape == "Grid" then
        local n    = math.ceil(count ^ (1/3))
        local nx   = (i-1) % n
        local ny   = math.floor((i-1)/n) % n
        local nz   = math.floor((i-1)/(n*n)) % n
        local half = (n-1)/2
        return Vector3.new(
            center.X + (nx-half)*gridSpacing,
            center.Y + (ny-half)*gridSpacing,
            center.Z + (nz-half)*gridSpacing
        )
    elseif shape == "Helix" then
        local frac  = i / math.max(count, 1)
        local angle = frac * helixTurns * 2 * math.pi + t
        return Vector3.new(
            center.X + radius * math.cos(angle),
            center.Y - helixHeight/2 + frac * helixHeight,
            center.Z + radius * math.sin(angle)
        )
    end
    return center
end

-- ═══════════════════════════════════════════════════════════════════════════════
-- ─── WEAPON FORMATION SYSTEM ─────────────────────────────────────────────────
-- each weapon is defined as a list of offsets relative to a weapon origin.
-- the weapon origin follows the joystick drag position in 3D space.
-- parts are assigned to weapon slots and their AlignPosition target updates
-- every heartbeat to the slot's world position.
-- ═══════════════════════════════════════════════════════════════════════════════

local WEAPONS = {
    -- ── SWORD ──────────────────────────────────────────────────────────────
    -- blade: long column of parts along +Z (forward)
    -- guard: horizontal row at base
    -- handle: 2 parts below guard
    Sword = function(count)
        local offsets = {}
        local BLADE_LEN = 14   -- parts in blade column
        local spacing   = 2.0

        -- blade (front to tip)
        for i = 1, math.min(BLADE_LEN, count) do
            table.insert(offsets, Vector3.new(0, 0, i * spacing))
        end
        -- guard (left + right of base)
        local guardSlots = { Vector3.new(-3, 0, 1.5), Vector3.new(-1.5, 0, 1.5),
                             Vector3.new(1.5, 0, 1.5), Vector3.new(3, 0, 1.5) }
        for _, g in ipairs(guardSlots) do
            if #offsets < count then table.insert(offsets, g) end
        end
        -- handle (behind guard)
        for i = 1, 3 do
            if #offsets < count then
                table.insert(offsets, Vector3.new(0, 0, -i * spacing * 0.8))
            end
        end
        -- pommel
        if #offsets < count then
            table.insert(offsets, Vector3.new(0, 0, -3 * spacing * 0.8 - 1.5))
        end
        -- fill remaining with a cloud cluster around handle
        local fi = 0
        while #offsets < count do
            fi = fi + 1
            table.insert(offsets, Vector3.new(
                math.sin(fi * 1.3) * 2,
                math.cos(fi * 0.9) * 1.5,
                -fi * 0.4
            ))
        end
        return offsets
    end,

    -- ── SHIELD ─────────────────────────────────────────────────────────────
    -- circular disc of parts facing the camera (XY plane)
    Shield = function(count)
        local offsets = {}
        local RINGS   = { {r=0, n=1}, {r=3,n=8}, {r=6,n=16}, {r=9,n=24}, {r=12,n=32} }
        for _, ring in ipairs(RINGS) do
            local step = ring.n > 0 and (2 * math.pi / ring.n) or 0
            for j = 0, ring.n - 1 do
                if #offsets < count then
                    local a = j * step
                    table.insert(offsets, Vector3.new(
                        ring.r * math.cos(a),
                        ring.r * math.sin(a),
                        0
                    ))
                end
            end
        end
        -- boss (center protrusion)
        if #offsets < count then table.insert(offsets, Vector3.new(0, 0, -2)) end
        -- fill
        local fi = 0
        while #offsets < count do
            fi = fi + 1
            table.insert(offsets, Vector3.new(math.sin(fi)*13, math.cos(fi)*13, 0))
        end
        return offsets
    end,

    -- ── SPEAR ──────────────────────────────────────────────────────────────
    -- long shaft + arrowhead tip
    Spear = function(count)
        local offsets = {}
        local SHAFT   = 20
        local sp      = 2.2

        -- shaft
        for i = 1, math.min(SHAFT, count) do
            table.insert(offsets, Vector3.new(0, 0, i * sp))
        end
        -- arrowhead (diamond tip, 5 parts)
        local tipBase = SHAFT * sp
        local tipPts  = {
            Vector3.new(0,   0,   tipBase + sp*1.5),
            Vector3.new(1.5, 0,   tipBase + sp*0.5),
            Vector3.new(-1.5,0,   tipBase + sp*0.5),
            Vector3.new(0,   1.5, tipBase + sp*0.5),
            Vector3.new(0,  -1.5, tipBase + sp*0.5),
        }
        for _, v in ipairs(tipPts) do
            if #offsets < count then table.insert(offsets, v) end
        end
        -- butt cap
        if #offsets < count then table.insert(offsets, Vector3.new(0, 0, -sp)) end
        -- fill
        local fi = 0
        while #offsets < count do
            fi = fi + 1
            table.insert(offsets, Vector3.new(math.sin(fi)*1.5, math.cos(fi)*1.5, fi * -0.5))
        end
        return offsets
    end,

    -- ── HAMMER ─────────────────────────────────────────────────────────────
    -- thick handle + wide rectangular hammerhead
    Hammer = function(count)
        local offsets = {}
        -- handle
        for i = 1, 8 do
            if #offsets < count then
                table.insert(offsets, Vector3.new(0, 0, -i * 2))
            end
        end
        -- hammerhead: 3x3x2 block at top
        for x = -2, 2, 2 do
            for y = -2, 2, 2 do
                for z = 0, 2, 2 do
                    if #offsets < count then
                        table.insert(offsets, Vector3.new(x * 2, y * 2, z * 1.5))
                    end
                end
            end
        end
        -- fill
        local fi = 0
        while #offsets < count do
            fi = fi + 1
            table.insert(offsets, Vector3.new(
                math.sin(fi * 0.7) * 5,
                math.cos(fi * 0.7) * 5,
                0
            ))
        end
        return offsets
    end,
}

-- weapon state
local WEAPON_NAMES  = { "None", "Sword", "Shield", "Spear", "Hammer" }
local weaponIndex   = 1  -- 1 = None
local weaponEnabled = false
local weaponAnchors = {}  -- list of anchor parts per slot
local weaponAttachments = {}  -- corresponding Attachment for each anchor

-- weapon origin tracking — follows the joystick 3D world position
-- offset: 8 studs in front of and slightly above the sphere center
local weaponOriginOffset = Vector3.new(0, 4, 8)

-- rotation accumulator for weapon spin (optional slow spin around Y)
local weaponRotT = 0

-- ── build/destroy weapon anchor nodes ────────────────────────────────────────

local function destroyWeaponAnchors()
    for _, a in ipairs(weaponAnchors) do
        if a and a.Parent then a:Destroy() end
    end
    weaponAnchors      = {}
    weaponAttachments  = {}
end

local function buildWeaponAnchors(count)
    destroyWeaponAnchors()
    for i = 1, count do
        local a           = Instance.new("Part", Folder)
        a.Anchored        = true
        a.CanCollide      = false
        a.Transparency    = 1
        a.Size            = Vector3.new(1,1,1)
        a.Position        = staticCenterPosition
        local att         = Instance.new("Attachment", a)
        weaponAnchors[i]     = a
        weaponAttachments[i] = att
    end
end

-- ── attach parts to weapon anchor nodes ──────────────────────────────────────

local function attachPartToWeaponSlot(part, slotIndex)
    -- clear existing movers
    for _, x in ipairs(part:GetChildren()) do
        if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
        or x:IsA("BodyPosition") or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
        or x:IsA("RocketPropulsion") then x:Destroy() end
    end
    for _, n in ipairs({"Attachment","AlignPosition","Torque","WeaponAtt","WeaponAP","WeaponTorque"}) do
        local c = part:FindFirstChild(n); if c then c:Destroy() end
    end

    part.CanCollide = false
    part.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)

    local pAtt     = Instance.new("Attachment", part); pAtt.Name = "WeaponAtt"
    local torque   = Instance.new("Torque",     part); torque.Name = "WeaponTorque"
    torque.Torque  = Vector3.new(1e9,1e9,1e9); torque.Attachment0 = pAtt

    local ap           = Instance.new("AlignPosition", part); ap.Name = "WeaponAP"
    ap.MaxForce        = MAX_FORCE
    ap.MaxVelocity     = MAX_VELOCITY
    ap.Responsiveness  = MAX_RESPONSE
    ap.Attachment0     = pAtt
    ap.Attachment1     = weaponAttachments[slotIndex]
    ap.Parent          = part
end

-- ── enable / disable weapon ───────────────────────────────────────────────────

local weaponParts = {}  -- parts currently assigned to weapon slots

local function disableWeapon()
    weaponEnabled = false
    -- strip weapon constraints from all weapon parts
    for _, p in ipairs(weaponParts) do
        if p and p.Parent then
            for _, n in ipairs({"WeaponAtt","WeaponAP","WeaponTorque"}) do
                local c = p:FindFirstChild(n); if c then c:Destroy() end
            end
        end
    end
    weaponParts = {}
    destroyWeaponAnchors()
end

local function enableWeapon(name)
    disableWeapon()
    if name == "None" then return end

    -- collect eligible parts from the claimed pool
    local pool = {}
    for _, p in ipairs(Network.BaseParts) do
        if p and p.Parent and p:IsDescendantOf(Workspace)
        and not p:IsDescendantOf(Folder) then
            table.insert(pool, p)
        end
    end

    -- also pull from the main parts list
    for _, p in ipairs(parts) do
        if p and p.Parent and not table.find(pool, p) then
            table.insert(pool, p)
        end
    end

    if #pool == 0 then return end

    -- generate offsets for this weapon shape
    local builder  = WEAPONS[name]
    if not builder then return end
    local offsets  = builder(#pool)
    local useCount = math.min(#pool, #offsets)

    buildWeaponAnchors(useCount)

    for i = 1, useCount do
        local p = pool[i]
        Network.RetainPart(p)
        attachPartToWeaponSlot(p, i)
        table.insert(weaponParts, p)
    end

    weaponEnabled = true
    playSound("12221967")
end

-- ── weapon origin from joystick / sphere position ─────────────────────────────
-- the weapon floats 8 studs in front of the sphere center
-- "front" = camera look direction projected to XZ, so it faces the player's view

local function getWeaponOriginCFrame()
    local cam     = Workspace.CurrentCamera
    local camCF   = cam and cam.CFrame or CFrame.new()
    local forward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
    if forward.Magnitude < 0.01 then forward = Vector3.new(0, 0, 1) end
    forward = forward.Unit

    local origin  = staticCenterPosition
        + forward * weaponOriginOffset.Z
        + Vector3.new(0, weaponOriginOffset.Y, 0)

    -- weapon faces the forward direction (so sword blade points forward)
    local cf = CFrame.lookAt(origin, origin + forward)
    return cf
end

-- ── weapon heartbeat: update anchor positions each frame ─────────────────────
RunService.Heartbeat:Connect(function(dt)
    if not weaponEnabled or #weaponAnchors == 0 then return end

    weaponRotT = weaponRotT + dt * 0.4  -- slow drift rotation

    local weaponCF    = getWeaponOriginCFrame()
    local weaponName  = WEAPON_NAMES[weaponIndex]
    local builder     = weaponName ~= "None" and WEAPONS[weaponName]
    local offsets     = builder and builder(#weaponAnchors) or {}

    for i, anchor in ipairs(weaponAnchors) do
        if anchor and anchor.Parent then
            local offset = offsets[i] or Vector3.new(0,0,0)
            -- transform offset from weapon-local space to world space
            local worldPos = weaponCF:PointToWorldSpace(offset)
            anchor.Position = worldPos

            -- also velocity-hammer the weapon part toward its slot
            local wp = weaponParts[i]
            if wp and wp.Parent then
                pcall(function()
                    local dir  = worldPos - wp.Position
                    local dist = dir.Magnitude
                    if dist > 0.01 then
                        wp.Velocity = (dir / dist) * HAMMER_SPEED
                    end
                end)
            end
        end
    end
end)

