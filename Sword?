SwordJoyLabel.Text                   = "rotate sword"
SwordJoyLabel.TextColor3             = Color3.fromRGB(220, 200, 255)
SwordJoyLabel.BackgroundTransparency = 1
SwordJoyLabel.Font                   = Enum.Font.Fondamento
SwordJoyLabel.TextSize               = 11
