local function bladeProfile(y)
    if y < 40 then return 3.5, 1.2 end
    local t  = math.max(0, (TOTAL - y) / (TOTAL - 40))
    local hw = 3.5 * t
    local hd = math.max(0.12, 1.0 * t)
    return hw, hd
end

-- ─── Orientation ─────────────────────────────────────────────────────────────
local swordYaw   = 0
local swordPitch = 0

local function rotatePoint(x, y, z)
    local cosY = math.cos(swordYaw);   local sinY = math.sin(swordYaw)
    local cosP = math.cos(swordPitch); local sinP = math.sin(swordPitch)
    local rx  = cosY*x - sinY*z
    local rz  = sinY*x + cosY*z
    local ry2 = cosP*y - sinP*rz
    local rz2 = sinP*y + cosP*rz
    return rx, ry2, rz2
end

-- ─── Section Map Builder ──────────────────────────────────────────────────────
local function buildSectionMap(count)
    local map        = {}
    local total_frac = 0
    for _, s in ipairs(SECTIONS) do total_frac = total_frac + s.frac end

    local assigned = 0
    local alloc    = {}
    for si, s in ipairs(SECTIONS) do
        local n = (si == #SECTIONS)
            and (count - assigned)
            or  math.max(1, math.floor(s.frac / total_frac * count))
        alloc[si] = n
        assigned  = assigned + n
    end

    local idx = 1
    for si, s in ipairs(SECTIONS) do
        local n    = alloc[si]
        local side = s.side or 0
        for j = 1, n do
            if idx > count then break end
            local lt     = (j - 0.5) / n
            local y      = s.yMin + lt * (s.yMax - s.yMin)
            local x, z   = 0, 0
            local seed   = j * 1.61803398875
            local thetaA = (seed % 1) * 2 * math.pi
            local thetaB = ((seed * 2.41421) % 1) * 2 * math.pi

            if s.id == "pommel_cap" then
                local phi = lt * math.pi
                local r   = 4.5 * math.sin(phi)
                x = r * math.cos(thetaA)
                z = r * math.sin(thetaA) * 0.75
                y = 1.5 + 4.5 * (1 - lt) * math.cos(phi) * 0.6
            elseif s.id == "pommel_shoulder" then
                local r = 3.5 + (j % 3) * 0.4
                x = r * math.cos(thetaA)
                z = r * math.sin(thetaA) * 0.55
            elseif s.id == "pommel_body" then
                local r = 4.2 * ((j % 5 + 1) / 5) ^ 0.5
                x = r * math.cos(thetaA) * 0.95
                z = r * math.sin(thetaA) * 0.60
            elseif s.id == "tang_end" then
                local r = 1.8 * ((j % 3 + 1) / 3) ^ 0.5
                x = r * math.cos(thetaA)
                z = r * math.sin(thetaA)
            elseif s.id == "pommel_conn" then
                local r = 2.2 * ((j % 3 + 1) / 3) ^ 0.5
                x = r * math.cos(thetaA)
                z = r * math.sin(thetaA) * 0.5
            elseif s.id == "tang" then
                local r = 1.3 * ((j % 4 + 1) / 4) ^ 0.5
                x = r * math.cos(thetaA)
                z = r * math.sin(thetaA)
            elseif s.id == "tang_shoulder" then
                local r = 2.0 + (j % 3) * 0.5
                x = r * math.cos(thetaA)
                z = r * math.sin(thetaA) * 0.4
            elseif s.id == "guard_terminal_l" or s.id == "guard_terminal_r" then
                x = side * (8.5 + (j % 3) * 0.7)
                z = ((j % 3) - 1) * 0.5
                y = 29 + (j % 4) * 0.7
            elseif s.id == "quillon_l" or s.id == "quillon_r" then
                local arm = (j / n) * 8.0
                x = side * arm
                z = ((j % 3) - 1) * 0.55
            elseif s.id == "guard_center" then
                x = ((j % 5) - 2) * 0.7
                z = ((j % 3) - 1) * 0.9
            elseif s.id == "langet_l" or s.id == "langet_r" then
                x = side * 3.3
                z = ((j % 2) - 0.5) * 0.35
            elseif s.id == "ricasso" then
                local hw, hd = bladeProfile(y)
                local r      = ((j % 5 + 1) / 5) ^ 0.5
                x = r * hw * math.cos(thetaA)
                z = r * hd * math.sin(thetaA)
            elseif s.id == "shoulder" then
                local r = 3.4 * ((j % 4 + 1) / 4) ^ 0.5
                x = r * math.cos(thetaA)
                z = r * math.sin(thetaA) * 0.32
            elseif s.id == "forte" then
                local hw, hd = bladeProfile(y)
                local r      = ((j % 6 + 1) / 6) ^ 0.5
                x = r * hw * math.cos(thetaA)
                z = r * hd * math.sin(thetaA)
            elseif s.id == "fuller" then
                local hw, _  = bladeProfile(y)
                x = ((j % 3) - 1) * (hw * 0.22)
                z = ((j % 2) - 0.5) * 0.18
            elseif s.id == "center" then
                local hw, hd = bladeProfile(y)
                local r      = ((j % 6 + 1) / 6) ^ 0.5
                x = r * hw * math.cos(thetaA)
                z = r * hd * math.sin(thetaA)
            elseif s.id == "foible" then
                local hw, hd = bladeProfile(y)
                local r      = ((j % 5 + 1) / 5) ^ 0.5
                x = r * hw * math.cos(thetaA)
                z = r * hd * math.sin(thetaA)
            elseif s.id == "false_edge" then
                local hw, hd = bladeProfile(y)
                local r      = ((j % 4 + 1) / 4) ^ 0.5
                x = r * hw * 0.65 * math.cos(thetaA)
                z = math.abs(hd * math.sin(thetaA)) * 0.45 + hd * 0.5
            elseif s.id == "point" then
                local hw, hd = bladeProfile(y)
                local r      = ((j % 5 + 1) / 5) ^ 0.38
                x = r * hw * math.cos(thetaA)
                z = r * hd * math.sin(thetaA)
            elseif s.id == "tip" then
                local frac2 = (y - 116) / 4
                local r     = (1 - frac2) * 1.4 * ((j % 3 + 1) / 3) ^ 0.5
                x = r * math.cos(thetaA)
                z = r * math.sin(thetaA) * 0.2
            end

            map[idx] = { x = x, y = y - TOTAL / 2, z = z }
            idx = idx + 1
        end
    end

    while idx <= count do
        map[idx] = { x = 0, y = TOTAL / 2, z = 0 }
        idx = idx + 1
    end

    return map
end

-- ─── Part Pool ────────────────────────────────────────────────────────────────
local parts      = {}
local sectionMap = {}
local lastCount  = 0

local function isEligible(part)
    if not part:IsA("BasePart") then return false end
    if part.Anchored then return false end
    if not part:IsDescendantOf(Workspace) then return false end
    if part:IsDescendantOf(Folder) then return false end
    if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then return false end
    local a = part.Parent
    while a and a ~= Workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
        a = a.Parent
    end
    return true
end

local function forcePart(part)
    for _, x in next, part:GetChildren() do
        if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
        or x:IsA("BodyPosition") or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
        or x:IsA("RocketPropulsion") then x:Destroy() end
    end
    if part:FindFirstChild("SwordAttach") then part:FindFirstChild("SwordAttach"):Destroy() end
    if part:FindFirstChild("SwordAlign")  then part:FindFirstChild("SwordAlign"):Destroy()  end
    if part:FindFirstChild("SwordTorque") then part:FindFirstChild("SwordTorque"):Destroy() end
    part.CanCollide = false
    local att  = Instance.new("Attachment", part); att.Name  = "SwordAttach"
    local torq = Instance.new("Torque",     part); torq.Name = "SwordTorque"
    torq.Torque      = Vector3.new(1e5, 1e5, 1e5)
    torq.Attachment0 = att
    local nodeAtt         = Instance.new("Attachment", MasterAnchor)
    local ap              = Instance.new("AlignPosition", part); ap.Name = "SwordAlign"
    ap.MaxForce           = math.huge
    ap.MaxVelocity        = math.huge
    ap.Responsiveness     = 1000
    ap.Attachment0        = att
    ap.Attachment1        = nodeAtt
    ap.Parent             = part
end

local function addPart(part)
    if not isEligible(part) then return end
    if table.find(parts, part) then return end
    if getgenv().Network then getgenv().Network.RetainPart(part) end
    forcePart(part)
    table.insert(parts, part)
end

local function removePart(part)
    local i = table.find(parts, part)
    if i then table.remove(parts, i) end
end

for _, d in ipairs(Workspace:GetDescendants()) do addPart(d) end
Workspace.DescendantAdded:Connect(addPart)
Workspace.DescendantRemoving:Connect(removePart)

RunService.Stepped:Connect(function()
    for _, p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored then addPart(p) end
    end
end)

-- ─── Shape Engine ─────────────────────────────────────────────────────────────
local sphereEnabled = false

RunService.Heartbeat:Connect(function()
    if not sphereEnabled then return end
    local count = #parts
    if count ~= lastCount then
        sectionMap = buildSectionMap(count)
        lastCount  = count
    end
    for i, part in ipairs(parts) do
        if part.Parent and not part.Anchored then
            local slot = sectionMap[i]
            if slot then
                local rx, ry, rz = rotatePoint(slot.x, slot.y, slot.z)
                local target     = centerPos + Vector3.new(rx, ry, rz)
                local dir        = target - part.Position
                if dir.Magnitude > 0 then
                    part.Velocity = dir.Unit * 999999
                end
            end
        end
    end
end)

