-- ─── FOLLOW + FINGER DRAG COEXIST ────────────────────────────────────────────
-- Finger down  → drag owns centerPos
-- Finger up    → follow resumes immediately (if enabled)
-- ═══════════════════════════════════════════════════════════════════════════════
local followOn      = false
local followDist    = 5
local fingerDragOn  = false
local fingerActive  = false
local fingerTouchId = nil

-- world position from screen tap
local function screenToWorld(screenPos)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local unitRay = cam:ScreenPointToRay(screenPos.X, screenPos.Y)
    local rp      = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { Folder, LocalPlayer.Character }
    local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, rp)
    if result then
        return Vector3.new(result.Position.X, result.Position.Y + 5, result.Position.Z)
    end
    local planeY = centerPos.Y
    local dir    = unitRay.Direction
    if math.abs(dir.Y) < 0.0001 then return unitRay.Origin + dir * 200 end
    local t = (planeY - unitRay.Origin.Y) / dir.Y
    if t > 0 then return unitRay.Origin + dir * t end
    return nil
end

-- master position writer
RunService.Heartbeat:Connect(function()
    if fingerActive then return end               -- drag has already written this frame
    if followOn and humanoidRootPart then
        local cf      = humanoidRootPart.CFrame
        local leftVec = -cf.RightVector
        centerPos             = cf.Position + leftVec * followDist
        MasterAnchor.Position = centerPos
    end
end)

