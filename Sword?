    local dec = makeButton(parent, "-", y+16, 0.2, 0.1, Color3.fromRGB(180, 60, 0))
    local disp = Instance.new("TextLabel")
    disp.Size             = UDim2.new(0.4, 0, 0, 28)
    disp.Position         = UDim2.new(0.3, 0, 0, y+16)
    disp.Text             = tostring(getValue())
    disp.BackgroundColor3 = Color3.fromRGB(30, 15, 60)
    disp.TextColor3       = Color3.fromRGB(255, 255, 255)
    disp.Font             = Enum.Font.Fondamento
    disp.TextSize         = 13
    disp.BorderSizePixel  = 0
    disp.Parent           = parent
    Instance.new("UICorner", disp).CornerRadius = UDim.new(0, 8)
    local inc = makeButton(parent, "+", y+16, 0.2, 0.7, Color3.fromRGB(60, 0, 180))
    dec.MouseButton1Click:Connect(function()
        onDec(); disp.Text = tostring(getValue()); playSound("12221967")
    end)
    inc.MouseButton1Click:Connect(function()
        onInc(); disp.Text = tostring(getValue()); playSound("12221967")
    end)
    return disp
end

