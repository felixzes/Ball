ScreenGui.Parent       = LocalPlayer:WaitForChild("PlayerGui")

local FingerOverlay = Instance.new("Frame")
FingerOverlay.Size                   = UDim2.new(1, 0, 1, 0)
FingerOverlay.BackgroundTransparency = 1
FingerOverlay.BorderSizePixel        = 0
FingerOverlay.ZIndex                 = 0
FingerOverlay.Visible                = false
FingerOverlay.Parent                 = ScreenGui

local FingerDot = Instance.new("Frame")
FingerDot.Size                   = UDim2.new(0, 26, 0, 26)
FingerDot.AnchorPoint            = Vector2.new(0.5, 0.5)
FingerDot.Position               = UDim2.new(0.5, 0, 0.5, 0)
FingerDot.BackgroundColor3       = Color3.fromRGB(160, 80, 255)
FingerDot.BackgroundTransparency = 0.15
FingerDot.BorderSizePixel        = 0
FingerDot.Visible                = false
FingerDot.ZIndex                 = 10
FingerDot.Parent                 = ScreenGui
Instance.new("UICorner", FingerDot).CornerRadius = UDim.new(1, 0)

local function applyDrag(screenPos)
    local wp = screenToWorld(screenPos)
    if not wp then return end
    centerPos             = wp
    MasterAnchor.Position = centerPos
    FingerDot.Position    = UDim2.new(0, screenPos.X, 0, screenPos.Y)
    FingerDot.Visible     = true
end

FingerOverlay.InputBegan:Connect(function(input)
    if not fingerDragOn then return end
    if input.UserInputType ~= Enum.UserInputType.Touch
    and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if fingerActive then return end
    fingerActive  = true
    fingerTouchId = input
    applyDrag(Vector2.new(input.Position.X, input.Position.Y))
end)

UserInputService.InputChanged:Connect(function(input)
    if not fingerDragOn or not fingerActive then return end
    if input ~= fingerTouchId then return end
    if input.UserInputType ~= Enum.UserInputType.Touch
    and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    applyDrag(Vector2.new(input.Position.X, input.Position.Y))
end)

UserInputService.InputEnded:Connect(function(input)
    if input ~= fingerTouchId then return end
    fingerActive  = false
    fingerTouchId = nil
    FingerDot.Visible = false
    -- follow resumes next Heartbeat automatically
end)

